---
// 「最安値で購入する」「最高値で買い取ってもらう」ボタン（別タブで開く）
import { SALE_PRIMARY, SWITCH_BASE as switchBase } from '../utils/buttonStyles';

interface Props {
  kind: 'sale' | 'buyback' | 'bulk';
  href: string;
  shop: string;
  size?: 'sm' | 'lg';
  /** 計測用のカード名（GA4 の affiliate_click イベントで送信） */
  item?: string;
  /** ボタン文言の上書き（例: 在庫なし時の「楽天市場で探す」） */
  label?: string;
}

const { kind, href, shop, size = 'sm', item, label } = Astro.props;
const network = href.includes('a8.net') ? 'a8' : href.includes('moshimo.com') ? 'moshimo' : undefined;

const styles = {
  // メイン：作業灯のアンバー（濃い文字）
  sale: { label: '最安値で購入する', color: SALE_PRIMARY, led: 'bg-slate-950/70' },
  // サブ：ダークサーフェス + エメラルドの細枠（購入ボタンと並べても主張しすぎない）
  buyback: {
    label: '最高値で買い取ってもらう',
    color: `${switchBase} border border-emerald-500/40 bg-slate-800/80 text-emerald-400 hover:border-emerald-400/70 hover:bg-emerald-950/40 focus-visible:outline-emerald-500`,
    led: 'bg-emerald-400 shadow-[0_0_6px_rgb(52_211_153/0.8)]',
  },
  // まとめて送る宅配買取（ふるいち）。在庫なしのカードで購入ボタンの代わりに出すため、アンバーの枠線で区別する
  bulk: {
    label: 'まとめて買取査定',
    color: `${switchBase} border border-amber-500/50 bg-slate-800/80 text-amber-400 hover:border-amber-400/80 hover:bg-amber-950/40 focus-visible:outline-amber-500`,
    led: 'bg-amber-400 shadow-[0_0_6px_rgb(251_191_36/0.8)]',
  },
}[kind];
---

<a
  href={href}
  target="_blank"
  rel="sponsored nofollow noopener noreferrer"
  data-aff-network={network}
  data-aff-shop={shop}
  data-aff-type={kind === 'bulk' ? 'buyback_bulk' : kind}
  data-aff-item={item}
  class:list={[
    'flex flex-col items-center justify-center gap-1 rounded-lg text-center font-bold leading-tight transition focus-visible:outline-2 focus-visible:outline-offset-2',
    styles.color,
    size === 'lg' ? 'px-4 py-3.5 text-base' : 'min-h-[3.5rem] px-2 py-2 text-[13px]',
  ]}
>
  <span>{label ?? styles.label}</span>
  <!-- 遷移先：計器のランプ + 店舗名 -->
  <span class:list={['flex items-center gap-1.5 font-mono font-medium tracking-wide opacity-80', size === 'lg' ? 'text-xs' : 'text-[10px]']}>
    <span class:list={['h-1.5 w-1.5 shrink-0 rounded-full', styles.led]} aria-hidden="true"></span>
    {shop}へ ↗
  </span>
</a>
