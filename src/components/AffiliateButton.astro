---
// 「最安値で購入する」「〇〇で査定を申し込む」ボタン（別タブで開く）
import { BUYBACK_PRIMARY, BUYBACK_SECONDARY, SALE_PRIMARY } from '../utils/buttonStyles';

interface Props {
  kind: 'sale' | 'buyback' | 'bulk';
  href: string;
  shop: string;
  size?: 'sm' | 'lg';
  /** 計測用のカード名（GA4 の affiliate_click イベントで送信） */
  item?: string;
  /** ボタン文言の上書き（例: 在庫なし時の「楽天市場で探す」） */
  label?: string;
}

const { kind, href, shop, size = 'sm', item, label } = Astro.props;
const network = href.includes('a8.net') ? 'a8' : href.includes('moshimo.com') ? 'moshimo' : undefined;

const styles = {
  // 購入：ファイアレッド
  sale: { label: '最安値で購入する', color: SALE_PRIMARY, led: 'bg-white/90' },
  // 買取：リーフグリーン
  // 文言は事実だけにする（買取額は各ショップの査定で決まるため、「最高値」「高価」などは使わない）
  buyback: { label: `${shop}で査定を申し込む`, color: BUYBACK_PRIMARY, led: 'bg-emerald-200' },
  // まとめて送る宅配買取（ふるいち）。カードごとの買取リンクがあるとき、在庫なしのカードでシングル買取ボタンと並ぶため、白地 + 緑枠で区別する
  bulk: { label: 'まとめて買取査定', color: BUYBACK_SECONDARY, led: 'bg-emerald-500' },
}[kind];
// 店名がボタンの文言に入っているときは、下の行で店名を繰り返さない
const shopLine = kind === 'buyback' && label === undefined ? '新しいタブで開く ↗' : `${shop}へ ↗`;
---

<a
  href={href}
  target="_blank"
  rel="sponsored nofollow noopener noreferrer"
  data-aff-network={network}
  data-aff-shop={shop}
  data-aff-type={kind === 'bulk' ? 'buyback_bulk' : kind}
  data-aff-item={item}
  class:list={[
    'flex flex-col items-center justify-center gap-1 text-center font-bold leading-tight transition focus-visible:outline-2 focus-visible:outline-offset-2',
    styles.color,
    size === 'lg' ? 'px-4 py-3.5 text-base' : 'min-h-[3.5rem] px-2 py-2 text-[13px]',
  ]}
>
  <span>{label ?? styles.label}</span>
  <!-- 遷移先：計器のランプ + 店舗名 -->
  <span class:list={['flex items-center gap-1.5 font-mono font-medium tracking-wide opacity-90', size === 'lg' ? 'text-xs' : 'text-[10px]']}>
    <span class:list={['h-1.5 w-1.5 shrink-0 rounded-full', styles.led]} aria-hidden="true"></span>
    {shopLine}
  </span>
</a>
