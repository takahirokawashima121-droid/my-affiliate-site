---
// 「最安値で購入する」ボタン（別タブで開く）。
// 買取のボタンは金額の近くに置かず、カードページの「買取査定に出す」（BuybackOptions）だけで出す
import { SALE_PRIMARY } from '../utils/buttonStyles';

interface Props {
  href: string;
  shop: string;
  size?: 'sm' | 'lg';
  /** 計測用のカード名（GA4 の affiliate_click イベントで送信） */
  item?: string;
  /** ボタン文言の上書き（例: 在庫なし時の「楽天市場で探す」） */
  label?: string;
  /** GA4 の affiliate_type（既定は sale） */
  type?: string;
}

const { href, shop, size = 'sm', item, label = '最安値で購入する', type = 'sale' } = Astro.props;
const network = href.includes('a8.net') ? 'a8' : href.includes('moshimo.com') ? 'moshimo' : undefined;
---

<a
  href={href}
  target="_blank"
  rel="sponsored nofollow noopener noreferrer"
  data-aff-network={network}
  data-aff-shop={shop}
  data-aff-type={type}
  data-aff-item={item}
  class:list={[
    'flex flex-col items-center justify-center gap-1 text-center font-bold leading-tight transition focus-visible:outline-2 focus-visible:outline-offset-2',
    SALE_PRIMARY,
    size === 'lg' ? 'px-4 py-3.5 text-base' : 'min-h-[3.5rem] px-2 py-2 text-[13px]',
  ]}
>
  <span>{label}</span>
  <!-- 遷移先：計器のランプ + 店舗名 -->
  <span class:list={['flex items-center gap-1.5 font-mono font-medium tracking-wide opacity-90', size === 'lg' ? 'text-xs' : 'text-[10px]']}>
    <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-white/90" aria-hidden="true"></span>
    {shop}へ ↗
  </span>
</a>
