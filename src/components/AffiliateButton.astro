---
// 「最安値で購入する」「最高値で買い取ってもらう」ボタン（別タブで開く）
interface Props {
  kind: 'sale' | 'buyback' | 'bulk';
  href: string;
  shop: string;
  size?: 'sm' | 'lg';
  /** 計測用のカード名（GA4 の affiliate_click イベントで送信） */
  item?: string;
  /** ボタン文言の上書き（例: 在庫なし時の「楽天市場で探す」） */
  label?: string;
}

const { kind, href, shop, size = 'sm', item, label } = Astro.props;
const network = href.includes('a8.net') ? 'a8' : href.includes('moshimo.com') ? 'moshimo' : undefined;

const styles = {
  sale: { label: '最安値で購入する', color: 'bg-rose-600 hover:bg-rose-700 focus-visible:outline-rose-600' },
  buyback: { label: '最高値で買い取ってもらう', color: 'bg-emerald-600 hover:bg-emerald-700 focus-visible:outline-emerald-600' },
  // まとめて送る宅配買取（ふるいち）。黄色地は白文字だと読みにくいため濃い文字
  bulk: { label: 'まとめて買取査定', color: 'bg-amber-400 !text-slate-900 hover:bg-amber-300 focus-visible:outline-amber-500' },
}[kind];
---

<a
  href={href}
  target="_blank"
  rel="sponsored nofollow noopener noreferrer"
  data-aff-network={network}
  data-aff-shop={shop}
  data-aff-type={kind === 'bulk' ? 'buyback_bulk' : kind}
  data-aff-item={item}
  class:list={[
    'flex flex-col items-center justify-center rounded-xl text-center font-bold text-white shadow-sm transition focus-visible:outline-2 focus-visible:outline-offset-2',
    styles.color,
    size === 'lg' ? 'px-4 py-4 text-base' : 'px-2 py-2.5 text-sm',
  ]}
>
  {label ?? styles.label}
  <span class:list={['font-normal opacity-90', size === 'lg' ? 'text-xs' : 'text-[10px]']}>{shop}へ</span>
</a>
