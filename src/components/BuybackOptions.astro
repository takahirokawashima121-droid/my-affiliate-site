---
// 買取の導線：まとめて送る（ふるいち宅配買取）。カードページで買取査定の申込先を出すのはこの欄だけ（買取目安の欄にはボタンを置かない）。
// カードごとの買取リンク（cards.json）は、src/config/affiliate.ts の SHOPS で提携先を止めている間は出さない
import { SHOPS } from '../config/affiliate';
import type { Card } from '../utils/cards';
import { cardBuybackLink, cardLabel } from '../utils/cards';

interface Props {
  card: Card;
  /** 在庫なしカード向けの見出し（購入の代わりに買取を前面に出す） */
  heading?: string;
}

const { card } = Astro.props;
const item = cardLabel(card);
const furuichi = SHOPS.furuichi;
const single = cardBuybackLink(card);

const options = [
  {
    icon: '📦',
    title: 'まとめてスリーブのまま送る',
    note: 'スリーブ・ローダー・ファイルのまま箱に入れて送れる宅配買取（無料宅配キットあり）',
    shop: furuichi.name,
    href: furuichi.url,
    type: 'buyback_bulk',
    color: 'border-amber-300 bg-amber-50 hover:border-amber-500 hover:bg-amber-100',
    network: furuichi.network,
  },
  ...(single
    ? [
        {
          icon: '🔍',
          title: '1枚ずつ査定に出す',
          note: 'カードを1枚ずつ査定する買取です。買取額はお店の査定で決まります',
          shop: single.shop,
          href: single.url,
          type: 'buyback_single',
          color: 'border-emerald-300 bg-emerald-50 hover:border-emerald-400 hover:bg-emerald-100',
          network: single.network,
        },
      ]
    : []),
];
const heading = Astro.props.heading ?? (options.length > 1 ? '買取に出す方法を選ぶ' : '買取査定に出す');
---

<section aria-labelledby={`buyback-options-${card.id}`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <h3 id={`buyback-options-${card.id}`} class="text-base font-bold text-slate-900">{heading}</h3>
  <div class:list={['mt-3 grid gap-3', options.length > 1 && 'sm:grid-cols-2']}>
    {options.map((o) => (
      <a
        href={o.href}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        data-aff-network={o.network}
        data-aff-shop={o.shop}
        data-aff-type={o.type}
        data-aff-item={item}
        class:list={['group flex flex-col rounded-xl border-2 p-4 transition', o.color]}
      >
        <span class="text-base font-bold text-slate-900">
          <span aria-hidden="true">{o.icon}</span> {o.title}
        </span>
        <span class="mt-1 text-xs leading-relaxed text-slate-600">{o.note}</span>
        <span class="mt-3 text-sm font-bold text-blue-600 group-hover:underline">{o.shop}で査定を申し込む →</span>
      </a>
    ))}
  </div>
  {/* カードごとの買取リンク（SHOPS で止めていないとき）の計測画像は、リンクと同じこの部品で出す。ふるいちの計測画像はページ共通の AffiliatePixels で読み込む */}
  {single?.impressionUrl && <img src={single.impressionUrl} width="1" height="1" alt="" class="absolute h-px w-px opacity-0" />}
</section>
