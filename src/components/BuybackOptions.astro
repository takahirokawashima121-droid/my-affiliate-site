---
// 買取の2択導線：まとめて送る（ふるいち宅配買取）／シングル・高額カード（カードごとの買取提携先）
import { SHOPS } from '../config/affiliate';
import type { Card } from '../utils/cards';
import { cardLabel } from '../utils/cards';

interface Props {
  card: Card;
  /** 在庫なしカード向けの見出し（購入の代わりに買取を前面に出す） */
  heading?: string;
}

const { card, heading = '買取に出す方法を選ぶ' } = Astro.props;
const { buybackShop, buybackUrl } = card.data;
const item = cardLabel(card);
const furuichi = SHOPS.furuichi;

const options = [
  {
    icon: '📦',
    title: 'まとめてスリーブのまま送る',
    note: 'スリーブ・ローダー・ファイルのまま箱に入れて送れる宅配買取（無料宅配キットあり）',
    shop: furuichi.name,
    href: furuichi.url,
    type: 'buyback_bulk',
    color: 'border-amber-300 bg-amber-50 hover:border-amber-400 hover:bg-amber-100',
    network: furuichi.network,
  },
  {
    icon: '🔍',
    title: 'シングル・高額カードの高価買取',
    note: '1枚ずつの査定で、高額カードを少しでも高く売りたい方に',
    shop: buybackShop,
    href: buybackUrl,
    type: 'buyback_single',
    color: 'border-emerald-300 bg-emerald-50 hover:border-emerald-400 hover:bg-emerald-100',
    network: buybackUrl.includes('a8.net') ? 'a8' : undefined,
  },
];
---

<section aria-labelledby={`buyback-options-${card.id}`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <h3 id={`buyback-options-${card.id}`} class="text-base font-bold text-slate-900">{heading}</h3>
  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    {options.map((o) => (
      <a
        href={o.href}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        data-aff-network={o.network}
        data-aff-shop={o.shop}
        data-aff-type={o.type}
        data-aff-item={item}
        class:list={['group flex flex-col rounded-xl border-2 p-4 transition', o.color]}
      >
        <span class="text-base font-bold text-slate-900">
          <span aria-hidden="true">{o.icon}</span> {o.title}
        </span>
        <span class="mt-1 text-xs leading-relaxed text-slate-600">{o.note}</span>
        <span class="mt-3 text-sm font-bold text-blue-600 group-hover:underline">{o.shop}で査定を申し込む →</span>
      </a>
    ))}
  </div>
</section>
