---
// カード画像（imageUrl 未設定時はプレースホルダーを表示）
import { cardLabel, type Card } from '../utils/cards';

interface Props {
  card: Card;
  eager?: boolean;
  class?: string;
}

const { card, eager = false, class: className } = Astro.props;
const { imageUrl } = card.data;
const label = cardLabel(card);
---

{imageUrl ? (
  <img
    src={imageUrl}
    alt={label}
    width="245"
    height="342"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    class:list={['aspect-[63/88] w-full rounded-lg object-cover shadow', className]}
  />
) : (
  <div
    class:list={['flex aspect-[63/88] w-full flex-col items-center justify-center rounded-lg bg-gradient-to-br from-slate-100 to-slate-200 text-slate-400 ring-1 ring-slate-200', className]}
    role="img"
    aria-label={`${label}（画像準備中）`}
  >
    <svg viewBox="0 0 24 24" class="h-1/4 max-h-16 w-1/4 max-w-16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h6m6 0h6"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <span class="mt-1 text-[10px]">画像準備中</span>
  </div>
)}
