---
import CardImage from './CardImage.astro';
import AffiliateButton from './AffiliateButton.astro';
import { cardLabel, cardModel, cardPath, priceGap, formatDateTime, formatYen, rarityClass, type Card } from '../utils/cards';

interface Props {
  card: Card;
  eager?: boolean;
}

const { card, eager = false } = Astro.props;
const { name, rarity, cardNumber, expansionCode, salePrice, saleShop, saleUrl, buybackPrice, buybackShop, buybackUrl, updatedAt } = card.data;
const gap = priceGap(card);
const model = cardModel(card);
---

<article
  class="card-item flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
  data-search={`${name} ${rarity} ${expansionCode} ${cardNumber}`}
  data-rarity={rarity}
  data-sale={salePrice}
  data-buyback={buybackPrice}
  data-updated={updatedAt.valueOf()}
>
  <!-- 上部（画像・カード情報）をクリックで詳細ページへ -->
  <a href={cardPath(card)} class="group flex gap-4 p-4 transition hover:bg-slate-50">
    <div class="w-24 shrink-0 sm:w-28">
      <CardImage card={card} eager={eager} />
    </div>

    <div class="flex min-w-0 flex-1 flex-col">
      <span class={`self-start rounded px-2 py-0.5 text-xs font-bold tracking-wide ${rarityClass(rarity)}`}>{rarity}</span>
      <h3 class="mt-1.5 text-base font-bold leading-snug text-slate-900 group-hover:text-indigo-600 sm:text-lg">
        {name} {rarity} <span class="mt-0.5 block font-mono text-xs font-semibold text-slate-500">[{model}]</span>
      </h3>
      <p class="mt-3 text-xs text-slate-500">
        差額 {gap.valid ? <span class="font-semibold text-slate-700">{formatYen(gap.spread)}</span> : <span class="font-semibold text-amber-700">相場確認中</span>}
      </p>
      <p class="mt-1 text-[11px] text-slate-400">
        更新: <time datetime={updatedAt.toISOString()}>{formatDateTime(updatedAt)}</time>
      </p>
      <span class="mt-auto pt-2 text-xs font-medium text-indigo-600">詳細・相場を見る →</span>
    </div>
  </a>

  <!-- 価格比較 -->
  <dl class="grid grid-cols-2 divide-x divide-slate-200 border-y border-slate-200 bg-slate-50 text-center">
    <div class="px-3 py-3">
      <dt class="text-[11px] font-medium text-slate-500">販売最安値</dt>
      <dd class="mt-0.5 text-xl font-extrabold tabular-nums text-rose-600 sm:text-2xl">{formatYen(salePrice)}</dd>
      <dd class="truncate text-[11px] text-slate-500">{saleShop}</dd>
    </div>
    <div class="px-3 py-3">
      <dt class="text-[11px] font-medium text-slate-500">買取最高値</dt>
      <dd class="mt-0.5 text-xl font-extrabold tabular-nums text-emerald-600 sm:text-2xl">{formatYen(buybackPrice)}</dd>
      <dd class="truncate text-[11px] text-slate-500">{buybackShop}{!gap.valid && <span class="ml-1 rounded bg-amber-100 px-1 text-amber-800">相場確認中</span>}</dd>
    </div>
  </dl>

  <!-- アフィリエイト導線 -->
  <div class="mt-auto grid grid-cols-2 gap-2 p-3">
    <AffiliateButton kind="sale" href={saleUrl} shop={saleShop} item={cardLabel(card)} />
    <AffiliateButton kind="buyback" href={buybackUrl} shop={buybackShop} item={cardLabel(card)} />
  </div>
</article>
