---
import CardImage from './CardImage.astro';
import AffiliateButton from './AffiliateButton.astro';
import CardTags from './CardTags.astro';
import { SHOPS } from '../config/affiliate';
import { SITE } from '../consts';
import { nameWithRarity } from '../utils/cardFormat';
import { buybackLink, cardBuybackLink, cardLabel, cardModel, cardPath, priceGap, showsBuybackPrice, mallOffers, bestOffer, formatDateTime, formatYen, type Card } from '../utils/cards';

interface Props {
  card: Card;
  eager?: boolean;
  /** 同名カードの中で最安値のとき true（「最安版」バッジ） */
  cheapest?: boolean;
}

const { card, eager = false, cheapest = false } = Astro.props;
const { name, rarity, cardNumber, expansionCode, buybackPrice, updatedAt } = card.data;
// 買取ボタンの遷移先（カードごとの買取リンクを止めている間は古本市場（ふるいち）の宅配買取）
const buyback = buybackLink(card);
const single = cardBuybackLink(card);
const gap = priceGap(card);
// 楽天・Yahoo! の2大モールのうち安い方を「販売最安値」として表示する
const offers = mallOffers(card);
const best = bestOffer(card);
const inStock = best !== null;
// 買取価格の「相場確認中」は、販売価格がある（在庫あり）のに逆ザヤの場合のみ
const buybackUnverified = inStock && !gap.valid;
const buybackShown = showsBuybackPrice(card); // 在庫なし（販売相場なし）なら買取額は「要査定」
const model = cardModel(card);
---

<article
  data-ga-item={card.data.name}
  class="card-item flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
  data-search={`${name} ${rarity} ${expansionCode} ${cardNumber}`}
  data-rarity={rarity}
  data-regulation={card.data.regulationMark ?? ''}
  data-sale={best ? best.price : ''}
  data-buyback={buybackShown ? buybackPrice : ''}
  data-updated={updatedAt.valueOf()}
>
  <!-- 上部（画像・カード情報）をクリックで詳細ページへ -->
  <a href={cardPath(card)} class="group flex items-start gap-3 p-3 transition hover:bg-slate-50 sm:gap-4 sm:p-4">
    <!-- 画像はポケカ比率の枠で幅いっぱいに表示（スマホ 112px / PC 128px）。文字列側は min-w-0 で折り返して押し出されないようにする -->
    <div class="w-28 shrink-0 sm:w-32">
      <CardImage card={card} eager={eager} sizes="(min-width: 640px) 128px, 112px" class="border border-slate-200 shadow-sm" />
    </div>

    <div class="flex min-w-0 flex-1 flex-col self-stretch">
      <CardTags card={card} cheapest={cheapest} />
      <h3 class="mt-1.5 text-base font-bold leading-snug text-slate-900 group-hover:text-blue-600 sm:text-lg">
        {nameWithRarity(card.data)} <span class="mt-0.5 block font-mono text-xs font-semibold text-slate-600">[{model}]</span>
      </h3>
      <p class="mt-3 text-xs text-slate-600">
        差額 {gap.valid ? <span class="font-semibold text-slate-700">{formatYen(gap.spread)}</span> : inStock ? <span class="font-semibold text-amber-700">相場確認中</span> : <span class="font-semibold text-slate-600">—</span>}
      </p>
      <p class="mt-1 text-[11px] text-slate-600">
        更新: <time datetime={updatedAt.toISOString()}>{formatDateTime(updatedAt)}</time>
      </p>
      <span class="mt-auto pt-2 text-xs font-medium text-blue-600">詳細・相場を見る →</span>
    </div>
  </a>

  <!-- 価格比較 -->
  <dl class="grid grid-cols-2 divide-x divide-slate-200 border-y border-slate-200 bg-slate-50 text-center">
    <div class="px-3 py-3">
      <dt class="text-[11px] font-medium text-slate-600">販売最安値</dt>
      {best ? (
        <dd class="mt-0.5 text-xl font-extrabold tabular-nums text-rose-600 sm:text-2xl">{formatYen(best.price)}</dd>
      ) : (
        <dd class="mt-1.5 text-base font-bold text-slate-600 sm:text-lg">在庫なし</dd>
      )}
      <dd class="truncate text-[11px] text-slate-600">{best ? best.shop : '楽天・Yahoo!'}</dd>
      {/* 2大モールの価格をコンパクトに併記（安い方を強調） */}
      <dd class="mt-1 flex justify-center gap-2 text-[10px] tabular-nums text-slate-600">
        {([['楽天', offers.rakuten], ['Yahoo!', offers.yahoo]] as const).map(([label, o]) => (
          <span class:list={[o && best && o.price === best.price && 'font-bold text-rose-600']}>{label} {o ? formatYen(o.price) : '—'}</span>
        ))}
      </dd>
    </div>
    <div class="px-3 py-3">
      <dt class="text-[11px] font-medium text-slate-600">買取目安</dt>
      {buybackShown ? (
        <dd class="mt-0.5 text-xl font-extrabold tabular-nums text-emerald-600 sm:text-2xl">{formatYen(buybackPrice)}</dd>
      ) : (
        <dd class="mt-1.5 text-base font-bold text-slate-600 sm:text-lg">要査定</dd>
      )}
      <dd class="text-[10px] leading-snug text-slate-600">{SITE.buybackEstimateNote}</dd>
      {buybackUnverified && <dd class="mt-0.5 text-[11px]"><span class="rounded bg-amber-100 px-1 text-amber-800">相場確認中</span></dd>}
    </div>
  </dl>

  <!-- アフィリエイト導線 -->
  <div class="mt-auto grid grid-cols-2 gap-2 p-3">
    {best ? (
      <Fragment>
        <AffiliateButton kind="sale" href={best.url} shop={best.shop} item={cardLabel(card)} />
        <AffiliateButton kind="buyback" href={buyback.url} shop={buyback.shop} item={cardLabel(card)} />
      </Fragment>
    ) : single ? (
      <Fragment>
        {/* 在庫なし：購入の代わりに買取査定を前面に出す */}
        <AffiliateButton kind="bulk" href={SHOPS.furuichi.url} shop={SHOPS.furuichi.name} item={cardLabel(card)} />
        <AffiliateButton kind="buyback" href={single.url} shop={single.shop} item={cardLabel(card)} label="シングル買取査定" />
      </Fragment>
    ) : (
      <div class="col-span-2">
        {/* 在庫なし：購入の代わりに買取査定を前面に出す */}
        <AffiliateButton kind="buyback" href={buyback.url} shop={buyback.shop} item={cardLabel(card)} />
      </div>
    )}
  </div>
</article>
