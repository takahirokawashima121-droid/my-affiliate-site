---
// カードのバッジ類：レアリティ / レギュレーションマーク / スタンダード対応 / 最安版
import { isStandardLegal, isStandardExempt, hasRarityMark, rarityClass, type Card } from '../utils/cards';
import { STANDARD_REGULATIONS } from '../consts';

interface Props {
  card: Card;
  /** 同名カードの中で最安値のとき true（「最安版」バッジを表示） */
  cheapest?: boolean;
  size?: 'sm' | 'lg';
}

const { card, cheapest = false, size = 'sm' } = Astro.props;
const { rarity, regulationMark } = card.data;
const standard = isStandardLegal(card);
// 例外リストによってのみスタンダードで使えるカード（マーク自体は旧レギュレーション）
const exempt = isStandardExempt(card) && !(regulationMark && (STANDARD_REGULATIONS as readonly string[]).includes(regulationMark));
const text = size === 'lg' ? 'text-sm' : 'text-xs';
---

<div class="flex flex-wrap items-center gap-1.5">
  {hasRarityMark(rarity) && <span class:list={['rounded px-2 py-0.5 font-bold tracking-wide', text, rarityClass(rarity)]}>{rarity}</span>}
  {regulationMark && (
    <span
      class:list={[
        'inline-flex items-center justify-center rounded border-2 font-mono font-extrabold leading-none',
        size === 'lg' ? 'h-6 w-6 text-sm' : 'h-5 w-5 text-xs',
        standard ? 'border-slate-200 bg-white text-slate-800' : 'border-slate-300 bg-slate-100 text-slate-600',
      ]}
      title={`レギュレーションマーク ${regulationMark}`}
      aria-label={`レギュレーション${regulationMark}`}
    >
      {regulationMark}
    </span>
  )}
  {standard && (
    <span class:list={['inline-flex items-center gap-0.5 rounded-full bg-emerald-500 px-2 py-0.5 font-bold text-white', text]} title={exempt ? '公式の例外リストにより、レギュレーションマークに関わらずスタンダードで使用できます' : '現在のスタンダードレギュレーションで使用できます'}>
      <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"></path></svg>
      スタンダード
    </span>
  )}
  {cheapest && (
    <span class:list={['rounded-full bg-amber-500/90 px-2 py-0.5 font-bold text-slate-950', text]} title="同じ名前のカードの中で販売価格が最も安いバージョンです">
      最安版
    </span>
  )}
</div>
