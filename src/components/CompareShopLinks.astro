---
// 大手ショップ・フリマの横断比較リンク。収益ボタンより控えめなアウトラインスタイル
// アフィリエイトのリンク（メルカリ）は rel="sponsored" と data-aff-* を付け、GA4 の affiliate_click で計測する
import { COMPARE_SHOPS } from '../config/compareShops';

interface Props {
  /** 検索キーワード（例: 「ナンジャモ 096/071」） */
  keyword: string;
}

const { keyword } = Astro.props;
const affiliateNames = COMPARE_SHOPS.filter((s) => s.affiliate).map((s) => s.name);
---

<section aria-labelledby="compare-shops" class="mt-4 rounded-2xl border border-slate-200 bg-white p-5">
  <h3 id="compare-shops" class="text-sm font-bold text-slate-900">
    <span aria-hidden="true">🔍</span> 他の大手ショップで在庫・価格を比較する
  </h3>
  <p class="mt-1 text-xs text-slate-500">
    「{keyword}」の検索結果を各サイトで開きます。{affiliateNames.length > 0 ? `${affiliateNames.join('・')}へのリンクはアフィリエイトリンクです（それ以外は当サイトの提携先ではありません）。` : '当サイトの提携先ではありません。'}
  </p>
  <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
    {COMPARE_SHOPS.map((shop) => (
      <li>
        <a
          href={shop.searchUrl(keyword)}
          target="_blank"
          rel={shop.affiliate ? 'sponsored nofollow noopener noreferrer' : 'noopener noreferrer'}
          data-compare-shop={shop.key}
          data-aff-network={shop.affiliate ? shop.key : undefined}
          data-aff-shop={shop.affiliate ? shop.name : undefined}
          data-aff-type={shop.affiliate ? 'sale_search' : undefined}
          data-aff-item={shop.affiliate ? keyword : undefined}
          class="flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:border-blue-400 hover:bg-blue-50 hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
        >
          {shop.name}
          <svg class="h-3.5 w-3.5 shrink-0 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5h5v5M19 5l-8 8M10 5H6a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4"></path>
          </svg>
        </a>
      </li>
    ))}
  </ul>
</section>
