---
// トップページの「最新優勝デッキ特集」（src/data/deck-columns.ts の FEATURED_DECKS から4〜6件）
// PC は3列、タブレットは2列、スマホは1列（画像を左に置いた横長カードで縦に伸びすぎないようにする）
import CardImage from './CardImage.astro';
import { DECK_COLUMNS, FEATURED_DECKS, columnPath } from '../data/deck-columns';
import { formatYen, type Card } from '../utils/cards';
import { deckBadgeClass, deckSummary } from '../utils/decks';

interface Props {
  cards: Card[];
}

const { cards } = Astro.props;
const featured = FEATURED_DECKS.slugs.map((slug) => {
  const column = DECK_COLUMNS.find((c) => c.slug === slug);
  if (!column) throw new Error(`FEATURED_DECKS の「${slug}」が DECK_COLUMNS にありません`);
  return { ...column, ...deckSummary(column, cards) };
});
---

<section aria-labelledby="featured-decks" class="mb-8 rounded-3xl border-2 border-amber-300 bg-gradient-to-br from-amber-50 via-white to-rose-50 p-4 shadow-sm sm:p-6">
  <h2 id="featured-decks" class="text-lg font-black text-slate-900 sm:text-xl">
    <span aria-hidden="true">🏆</span> {FEATURED_DECKS.title}
  </h2>
  <p class="mt-1 text-xs text-slate-600 sm:text-sm">優勝デッキの60枚レシピ・回し方を、採用カードの最安値つきで解説しています。</p>

  <ul class="mt-4 grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
    {featured.map((c) => (
      <li>
        <a href={columnPath(c)} class="group flex h-full gap-3 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm transition hover:-translate-y-0.5 hover:border-amber-400 hover:shadow-md sm:p-4">
          {c.mainCard && <span class="block w-14 shrink-0 sm:w-16"><CardImage card={c.mainCard} sizes="64px" /></span>}
          <span class="flex min-w-0 flex-1 flex-col">
            <span class="flex flex-wrap gap-1">
              {c.badges.map((b) => <span class={`rounded-full px-2 py-0.5 text-[10px] font-bold ${deckBadgeClass(b)}`}>{b}</span>)}
            </span>
            <span class="mt-1 text-base font-black leading-snug text-slate-900 group-hover:text-blue-600">{c.deckName}</span>
            <span class="mt-0.5 line-clamp-2 text-xs leading-relaxed text-slate-600">{c.highlight}</span>
            <span class="mt-auto flex items-baseline justify-between gap-2 pt-2 text-xs">
              {c.estimate > 0 ? <span class="text-slate-500">60枚の概算 <span class="font-bold tabular-nums text-rose-600">{formatYen(c.estimate)}</span></span> : <span></span>}
              <span class="shrink-0 font-bold text-blue-600">デッキを見る →</span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <a href="/columns/" class="mt-4 flex items-center justify-center rounded-xl bg-amber-400 px-4 py-3 text-sm font-black text-slate-900 shadow-sm transition hover:bg-amber-300 sm:text-base">
    優勝デッキ解説・コラム一覧を見る（全{DECK_COLUMNS.length}記事） →
  </a>
</section>
