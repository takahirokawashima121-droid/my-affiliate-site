---
// トップページの「最新ジムバトル優勝デッキ特集」。deck-columns.json から優勝日が新しい順に自動で選ぶ（latestGymWinners）
// PC は3列、タブレットは2列、スマホは1列（画像を左に置いた横長カードで縦に伸びすぎないようにする）
import CardImage from './CardImage.astro';
import { DECK_COLUMNS, columnPath, eventDate, latestGymWinners } from '../data/deck-columns';
import { formatYen, type Card } from '../utils/cards';
import { deckBadgeClass, deckSummary } from '../utils/decks';

interface Props {
  cards: Card[];
}

const { cards } = Astro.props;
const { title, columns } = latestGymWinners(6);
const featured = columns.map((column) => ({ ...column, ...deckSummary(column, cards), date: eventDate(column) }));
---

{featured.length > 0 && (
  <section aria-labelledby="featured-decks" class="bg-lab-panel lab-corners mb-8 rounded-2xl border border-lab-600 p-4 text-slate-100 shadow-xl shadow-black/20 sm:p-6">
    <p class="font-mono text-[11px] font-bold tracking-widest text-gauge">LATEST GYM BATTLE WINNERS / AUTO-SORTED</p>
    <h2 id="featured-decks" class="mt-1 text-lg font-black sm:text-xl">
      <span aria-hidden="true">🏆</span> {title}
    </h2>
    <p class="mt-1 text-xs text-slate-300 sm:text-sm">優勝日が新しい順に自動で入れ替わります。60枚レシピ・回し方と、採用パーツの最安値をまとめてチェック。</p>

    <ul class="mt-4 grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
      {featured.map((c) => (
        <li class="flex h-full flex-col rounded-xl border border-lab-600 bg-lab-800/90 p-3 transition hover:border-lamp/70 sm:p-4">
          <a href={columnPath(c)} class="group flex flex-1 gap-3">
            {c.mainCard && <span class="block w-16 shrink-0 overflow-hidden rounded-md ring-1 ring-lab-600 sm:w-[4.5rem]"><CardImage card={c.mainCard} sizes="72px" /></span>}
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="flex flex-wrap items-center gap-1">
                <time datetime={c.date} class="spec-tag border-lamp/60 bg-lamp/10 text-lamp">🏆 {c.date.replaceAll('-', '.')} 優勝</time>
                {c.badges.map((b) => <span class={`rounded-sm px-1.5 py-0.5 text-[10px] font-bold ${deckBadgeClass(b)}`}>{b}</span>)}
              </span>
              <span class="mt-1.5 text-base font-black leading-snug text-slate-100 group-hover:text-lamp">{c.deckName}</span>
              <span class="mt-0.5 line-clamp-2 text-xs leading-relaxed text-slate-300">{c.highlight}</span>
              {c.estimate > 0 && (
                <span class="mt-1.5 font-mono text-[11px] text-slate-400">60枚の概算 <span class="text-sm font-bold tabular-nums text-gauge">{formatYen(c.estimate)}</span></span>
              )}
            </span>
          </a>
          <span class="mt-3 grid grid-cols-2 gap-2 text-xs font-black">
            <a href={columnPath(c)} class="rounded-md border border-lab-600 px-2 py-2 text-center text-slate-200 transition hover:border-slate-600 hover:text-slate-100">デッキ解説</a>
            <a href={`${columnPath(c)}#deck-recipe`} class="rounded-md bg-lamp/90 px-2 py-2 text-center text-slate-950 transition hover:bg-amber-400">⚡ パーツ一括調達</a>
          </span>
        </li>
      ))}
    </ul>

    <a href="/columns/" class="mt-4 flex items-center justify-center rounded-lg border border-lamp/60 px-4 py-3 text-sm font-black text-lamp transition hover:bg-lamp/90 hover:text-slate-950 sm:text-base">
      優勝デッキ解説・コラム一覧を見る（全{DECK_COLUMNS.length}記事） →
    </a>
  </section>
)}
