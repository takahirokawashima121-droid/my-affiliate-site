---
import { SITE } from '../consts';
const year = new Date().getFullYear();

// 楽天ウェブサービスのクレジット表記（規約により公式の HTML を改変せずにそのまま掲載する）
// https://webservice.rakuten.co.jp/guide/credit
const rakutenCredit = `<!-- Rakuten Web Services Attribution Snippet FROM HERE -->
<a href="https://developers.rakuten.com/" target="_blank">Supported by Rakuten Developers</a>
<!-- Rakuten Web Services Attribution Snippet TO HERE -->`;

// Yahoo! JAPAN Web API のクレジット表記（規約により公式の HTML・CSS・色・サイズを改変せずに掲載する）
// https://developer.yahoo.co.jp/attribution/
const yahooCredit = `<!-- Begin Yahoo! JAPAN Web Services Attribution Snippet -->
<span style="margin:15px 15px 15px 15px"><a href="https://developer.yahoo.co.jp/sitemap/">Webサービス by Yahoo! JAPAN</a></span>
<!-- End Yahoo! JAPAN Web Services Attribution Snippet -->`;
---

<footer class="mt-12 border-t border-lab-700 bg-lab-950">
  <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-slate-300">
    <p class="mb-2 text-xs leading-relaxed text-slate-400">
      当サイトはアフィリエイトプログラムに参加しており、掲載ショップへのリンクから購入・買取申込をされた場合に報酬を得ることがあります。
    </p>
    <p class="mb-4 text-xs leading-relaxed text-slate-400">
      掲載価格は更新日時点の参考価格です。「ポケモンカードゲーム」は株式会社ポケモンの登録商標であり、当サイトは公式とは関係ありません。
    </p>
    <!-- API のクレジット表記：規約で見た目の改変が禁止されているため、リンクはブラウザ標準の表示に戻す（Tailwind のリセットを打ち消す）。標準のリンク色が読めるよう明るい面に載せる -->
    <p class="mb-4 rounded-md bg-white px-3 py-2 text-xs text-slate-600 [&_a]:[color:revert] [&_a]:[text-decoration:revert]">
      販売価格は楽天ウェブサービス・Yahoo!ショッピングAPIのデータを利用しています。<Fragment set:html={rakutenCredit} /><Fragment set:html={yahooCredit} />
    </p>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.title}（{SITE.shortName}）<span class="ml-2 font-mono text-xs tracking-widest text-lamp/70">{SITE.englishName}</span></p>
      <ul class="flex flex-wrap gap-4">
        <li><a href="/" class="hover:text-lamp">パーツ検索</a></li>
        <li><a href="/tier/" class="hover:text-lamp">環境Tier表</a></li>
        <li><a href="/blog/" class="hover:text-lamp">コラム一覧</a></li>
        <li><a href="/about/" class="hover:text-lamp">運営者情報</a></li>
        <li><a href="/privacy/" class="hover:text-lamp">プライバシーポリシー・免責事項</a></li>
        <li><a href="/rss.xml" class="hover:text-lamp">RSS</a></li>
      </ul>
    </div>
  </div>
</footer>
