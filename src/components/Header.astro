---
import { SITE, NAV } from '../consts';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-20 bg-white/90 shadow-sm backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-slate-900">
      <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8 drop-shadow-sm" />
      <span class="flex flex-col leading-none">
        <span class="text-lg font-extrabold tracking-tight sm:text-xl">{SITE.title}</span>
        <span class="mt-0.5 text-[10px] font-bold tracking-widest text-slate-500">{SITE.englishName} / {SITE.shortName}</span>
      </span>
    </a>

    <nav aria-label="メインメニュー" class="hidden sm:block">
      <ul class="flex gap-6 text-sm font-medium">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['transition hover:text-brand-600', isActive(item.href) ? 'text-brand-600' : 'text-gray-600']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- モバイル: JS不要の details/summary メニュー -->
    <details class="relative sm:hidden">
      <summary class="cursor-pointer list-none rounded p-2 text-gray-700 hover:bg-gray-100 [&::-webkit-details-marker]:hidden" aria-label="メニューを開く">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </summary>
      <ul class="absolute right-0 mt-2 w-44 rounded-lg border border-gray-200 bg-white py-2 shadow-lg">
        {NAV.map((item) => (
          <li><a href={item.href} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">{item.label}</a></li>
        ))}
      </ul>
    </details>
  </div>
  <!-- ポケモンらしいアクセントライン（レッド・イエロー・ブルー） -->
  <div class="h-1 bg-gradient-to-r from-red-500 via-amber-400 to-blue-500" aria-hidden="true"></div>
</header>
