---
import { SITE, NAV } from '../consts';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!-- 広告表記（ステマ規制対応）：どのページでも開いてすぐ見える位置に出す。スクロールすると隠れる -->
<p class="bg-slate-100 px-4 py-1 text-center text-[11px] text-slate-600">当サイトはアフィリエイト広告（PR）を利用しています</p>
<header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 shadow-sm backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-slate-900">
      <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8 drop-shadow-sm" />
      <span class="flex flex-col leading-none">
        <span class="text-lg font-extrabold tracking-tight sm:text-xl">{SITE.title}</span>
        <span class="mt-0.5 font-mono text-[10px] font-bold tracking-widest text-amber-700">{SITE.englishName} / {SITE.shortName}</span>
      </span>
    </a>

    <nav aria-label="メインメニュー" class="hidden md:block">
      <ul class="flex gap-5 text-sm font-medium lg:gap-6">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['border-b-2 pb-1 transition hover:text-amber-700', isActive(item.href) ? 'border-amber-500 text-amber-700' : 'border-transparent text-slate-700']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- モバイル: JS不要の details/summary メニュー -->
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded p-2 text-slate-800 hover:bg-slate-100 [&::-webkit-details-marker]:hidden" aria-label="メニューを開く">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </summary>
      <ul class="absolute right-0 mt-2 w-44 rounded-lg border border-slate-300 bg-white py-2 shadow-lg shadow-slate-900/10">
        {NAV.map((item) => (
          <li><a href={item.href} class="block px-4 py-2 text-sm text-slate-800 hover:bg-slate-100 hover:text-amber-700">{item.label}</a></li>
        ))}
      </ul>
    </details>
  </div>
  <!-- コーションライン（細いハザードストライプ） -->
  <div class="bg-hazard h-1" aria-hidden="true"></div>
</header>
