---
// 購入先の比較ボタン：楽天市場・Yahoo!ショッピング（もしもアフィリエイト経由の検索結果）とメルカリ（メルカリアンバサダーの afid 付き検索結果）
// ※Bee本舗通販店（A8.net）は下段の CompareShopLinks に表示する
import { MALLS, moshimoClickUrl, moshimoImpressionUrl, type MallKey } from '../utils/moshimo';
import { mercariSearchUrl } from '../config/affiliate';
import { SWITCH_BASE } from '../utils/buttonStyles';

interface Props {
  /** 検索キーワード（cardSearchKeyword() の結果。例: 「ナンジャモ SAR 096/071 ポケカ」） */
  keyword: string;
  /** メルカリの検索キーワード（例: 「ナンジャモ 096/071」） */
  shopKeyword: string;
}

const { keyword, shopKeyword } = Astro.props;

// ボタンはダークサーフェスで統一し、各サービスのブランドカラーはランプ（左の丸）にだけ使う
const malls: { mall: MallKey; led: string }[] = [
  { mall: 'rakuten', led: 'bg-[#bf0000]' },
  { mall: 'yahoo', led: 'bg-[#ff0033]' },
];

const buttons = [
  ...malls.map(({ mall, led }) => ({
    href: moshimoClickUrl(mall, keyword),
    label: `${MALLS[mall].label}で探す`,
    icon: '',
    network: 'moshimo',
    shop: MALLS[mall].label,
    type: 'mall_search',
    led,
  })),
  {
    href: mercariSearchUrl(shopKeyword),
    label: 'メルカリで探す',
    icon: '',
    network: 'mercari',
    shop: 'メルカリ',
    type: 'mall_search',
    led: 'bg-[#ff333f]',
  },
];
---

<section aria-labelledby="mall-search" class="mt-6 rounded-2xl border border-slate-700/60 bg-slate-900 p-5 shadow-sm">
  <h3 id="mall-search" class="text-base font-bold text-slate-100">モール・フリマで在庫・価格を探す</h3>
  <p class="mt-1 text-xs text-slate-400">
    楽天市場・Yahoo!ショッピング・メルカリは「{shopKeyword}」の検索結果を開きます（楽天市場・Yahoo!ショッピングはレアリティも含めて検索）。
  </p>
  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    {buttons.map((b) => (
      <a
        href={b.href}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        data-aff-network={b.network}
        data-aff-shop={b.shop}
        data-aff-type={b.type}
        data-aff-item={keyword}
        class:list={[
          SWITCH_BASE,
          'flex items-center justify-center gap-2 rounded-lg border border-slate-600 bg-slate-800/80 px-4 py-3.5 text-center text-base font-bold text-slate-200 transition hover:border-amber-400/70 hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500',
        ]}
      >
        <span class:list={['h-2 w-2 shrink-0 rounded-full', b.led]} aria-hidden="true"></span>
        {b.icon && <span aria-hidden="true">{b.icon}</span>}
        {b.label}
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5h5v5M19 5l-8 8M10 5H6a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4"></path>
        </svg>
      </a>
    ))}
  </div>
  <!-- もしもアフィリエイトのインプレッション計測（メルカリには計測画像なし。Bee本舗の A8 計測画像はページ共通の AffiliatePixels で読み込む） -->
  {malls.map(({ mall }) => (
    <img src={moshimoImpressionUrl(mall)} width="1" height="1" alt="" loading="eager" style="border:none;position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;" />
  ))}
</section>
