---
// 購入先の比較ボタン：楽天市場・Yahoo!ショッピング（もしもアフィリエイト経由の検索結果）と Bee本舗通販店（A8.net）
import { MALLS, moshimoClickUrl, moshimoImpressionUrl, type MallKey } from '../utils/moshimo';
import { SHOPS, beeHonpoLink } from '../config/affiliate';

interface Props {
  /** 検索キーワード（cardSearchKeyword() の結果。例: 「ナンジャモ SAR 096/071 ポケカ」） */
  keyword: string;
  /** Bee本舗のサイト内検索用キーワード（例: 「ナンジャモ 096/071」） */
  shopKeyword: string;
}

const { keyword, shopKeyword } = Astro.props;

const malls: { mall: MallKey; color: string }[] = [
  { mall: 'rakuten', color: 'bg-[#bf0000] hover:bg-[#990000] focus-visible:outline-[#bf0000]' },
  { mall: 'yahoo', color: 'bg-[#ff0033] hover:bg-[#d6002b] focus-visible:outline-[#ff0033]' },
];

// ディープリンクが使えない場合は通販店トップへ遷移するため、「探す」ではなく「通販へ」と表示する
const bee = beeHonpoLink(shopKeyword);

const buttons = [
  ...malls.map(({ mall, color }) => ({
    href: moshimoClickUrl(mall, keyword),
    label: `${MALLS[mall].label}で探す`,
    icon: '',
    network: 'moshimo',
    shop: MALLS[mall].label,
    type: 'mall_search',
    color,
  })),
  {
    href: bee.href,
    label: bee.searchable ? `${SHOPS.beehonpo.name}で探す（シングル）` : `${SHOPS.beehonpo.name}通販へ`,
    icon: '🐝',
    network: SHOPS.beehonpo.network,
    shop: SHOPS.beehonpo.name,
    type: bee.searchable ? 'sale_specialty_search' : 'sale_specialty',
    // Bee本舗のイメージカラー（はちみつ色）。白文字が読めるよう濃いめのオレンジに
    color: 'bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-700 hover:to-orange-700 focus-visible:outline-orange-600',
  },
];
---

<section aria-labelledby="mall-search" class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <h3 id="mall-search" class="text-base font-bold text-slate-900">モール・専門店で在庫・価格を探す</h3>
  <p class="mt-1 text-xs text-slate-500">
    楽天市場・Yahoo!ショッピングは「{keyword}」の検索結果を開きます。{bee.searchable ? `${SHOPS.beehonpo.name}は「${shopKeyword}」で検索します。` : `${SHOPS.beehonpo.name}はトレカ専門店の通販サイトを開きます。`}
  </p>
  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    {buttons.map((b) => (
      <a
        href={b.href}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        data-aff-network={b.network}
        data-aff-shop={b.shop}
        data-aff-type={b.type}
        data-aff-item={keyword}
        class:list={[
          'flex items-center justify-center gap-2 rounded-xl px-4 py-3.5 text-center text-base font-bold text-white shadow-sm transition focus-visible:outline-2 focus-visible:outline-offset-2',
          b.color,
        ]}
      >
        {b.icon && <span aria-hidden="true">{b.icon}</span>}
        {b.label}
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5h5v5M19 5l-8 8M10 5H6a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4"></path>
        </svg>
      </a>
    ))}
  </div>
  <!-- もしもアフィリエイトのインプレッション計測（Bee本舗の A8 計測画像はページ共通の AffiliatePixels で読み込む） -->
  {malls.map(({ mall }) => (
    <img src={moshimoImpressionUrl(mall)} width="1" height="1" alt="" loading="eager" style="border:none;position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;" />
  ))}
</section>
