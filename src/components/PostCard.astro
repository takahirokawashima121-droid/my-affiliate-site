---
import type { Post } from '../utils/posts';
import { formatDate } from '../utils/posts';

interface Props {
  post: Post;
  eager?: boolean;
}
const { post, eager = false } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
const href = `/blog/${post.id}/`;
---

<article class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white transition hover:shadow-md">
  {heroImage && (
    <a href={href} tabindex="-1" aria-hidden="true">
      <img
        src={heroImage}
        alt=""
        width="800"
        height="420"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="aspect-[40/21] w-full object-cover"
      />
    </a>
  )}
  <div class="flex flex-1 flex-col p-5">
    <time datetime={pubDate.toISOString()} class="text-xs text-slate-600">{formatDate(pubDate)}</time>
    <h2 class="mt-1 text-lg font-bold leading-snug text-slate-900">
      <a href={href} class="group-hover:text-blue-600">{title}</a>
    </h2>
    <p class="mt-2 line-clamp-3 text-sm text-slate-600">{description}</p>
    {tags.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-2 pt-4">
        {tags.map((tag) => (
          <li>
            <a href={`/tags/${tag}/`} class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-600 hover:bg-blue-50 hover:text-blue-700">#{tag}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
