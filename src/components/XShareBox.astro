---
// 運営者向け: X 告知用のコピペ文（本番でもスマホからコピーできるよう、折りたたんで目立たない形で置く）
// デッキ解説（DeckColumn.astro）と環境Tier表（/tier/）で使う。文面は src/utils/shareText.ts で作る
import { xWeightedLength, PARENT_POST_LIMIT } from '../utils/shareText';

interface Props {
  posts: { parent: string; reply: string };
}

const { posts } = Astro.props;
const xIntent = `https://x.com/intent/post?text=${encodeURIComponent(posts.parent)}`;
---

<details class="mt-12 rounded-xl border border-slate-200 bg-white text-sm text-slate-600" data-nosnippet>
  <summary class="cursor-pointer select-none px-4 py-3 text-xs font-bold text-slate-500">📱 Xシェア用テキスト（運営者向け・ワンクリックコピー）</summary>
  <div class="space-y-4 border-t border-slate-100 px-4 py-4">
    {[
      { id: 'x-parent', label: `1ポスト目（親・URLなし）: ${xWeightedLength(posts.parent)}/${PARENT_POST_LIMIT}（全角1文字＝2）`, text: posts.parent, rows: 5 },
      { id: 'x-reply', label: '2ポスト目（リプライ用）', text: posts.reply, rows: 3 },
    ].map((p) => (
      <div>
        <label for={p.id} class="block text-xs font-bold text-slate-500">{p.label}</label>
        <textarea id={p.id} readonly rows={p.rows} class="mt-1 w-full resize-none rounded-lg border border-slate-200 bg-slate-50 p-2 text-sm leading-relaxed text-slate-800">{p.text}</textarea>
        <button type="button" data-copy={p.id} class="mt-1 rounded-lg bg-slate-800 px-3 py-1.5 text-xs font-bold text-white hover:bg-slate-700">コピー</button>
      </div>
    ))}
    <a href={xIntent} target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-bold text-blue-600 underline">1ポスト目を X の投稿画面で開く</a>
  </div>
</details>

<script>
  // Xシェア用テキストのコピー（クリップボード API が使えない環境では選択状態にする）
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      const area = document.getElementById(button.dataset.copy ?? '') as HTMLTextAreaElement | null;
      if (!area) return;
      try {
        await navigator.clipboard.writeText(area.value);
        button.textContent = 'コピーしました';
      } catch {
        area.select();
        button.textContent = '選択しました（長押しでコピー）';
      }
      setTimeout(() => (button.textContent = 'コピー'), 2000);
    });
  }
</script>
