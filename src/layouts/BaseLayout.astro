---
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import { SITE } from '../consts';

type Props = HeadProps;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class="bg-lab-floor flex min-h-screen flex-col pb-[calc(4rem+env(safe-area-inset-bottom))] font-sans text-slate-200 antialiased md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-slate-900 focus:px-3 focus:py-2">本文へスキップ</a>
    <Header />
    <!-- 工房の床（ダーク）の上に、本文を載せる「作業台」パネルを置く（同じダークトーンで統一）。スマホは画面幅いっぱい、PC は角の丸いパネル -->
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 sm:px-4 sm:py-8">
      <div class="bg-workbench shadow-2xl shadow-black/40 sm:rounded-2xl sm:ring-1 sm:ring-slate-700/60">
        <div class="bg-hazard h-1.5 opacity-70 sm:rounded-t-2xl" aria-hidden="true"></div>
        <div class="px-4 py-8 sm:px-8 sm:py-10">
          <slot />
        </div>
      </div>
    </main>
    <Footer />
    <MobileBottomNav />
  </body>
</html>
