---
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import { SITE } from '../consts';

type Props = HeadProps;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class="bg-lab-floor flex min-h-screen flex-col pb-[calc(4rem+env(safe-area-inset-bottom))] font-sans text-slate-800 antialiased md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2">本文へスキップ</a>
    <Header />
    <!-- 研究所の床（青灰ホワイト + 方眼）の上に、白い独立カードとして各セクションを並べる -->
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:py-10">
      <slot />
    </main>
    <Footer />
    <MobileBottomNav />
  </body>
</html>
