---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import { formatDate, readingTime, type Post } from '../utils/posts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  related: Post[];
}

const { post, headings, related } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, affiliate } = post.data;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 構造化データ（BlogPosting）
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: new URL(heroImage ?? SITE.ogImage, Astro.site).toString(),
  author: { '@type': 'Person', name: SITE.author, url: new URL('/about/', Astro.site).toString() },
  publisher: { '@type': 'Organization', name: SITE.title },
  keywords: tags.join(', '),
};
---

<BaseLayout title={title} description={description} image={heroImage} type="article" pubDate={pubDate} updatedDate={updatedDate} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl">
    <Breadcrumbs items={[{ name: 'ホーム', href: '/' }, { name: '記事一覧', href: '/blog/' }, { name: title, href: Astro.url.pathname }]} />

    <article>
      <header class="mb-8">
        {affiliate && <p class="mb-3 inline-block rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-500">PR・本記事はアフィリエイト広告を含みます</p>}
        <h1 class="text-2xl font-bold leading-tight text-gray-900 sm:text-3xl">{title}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
          <span>公開: <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
          {updatedDate && <span>更新: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
          <span>約{readingTime(post.body)}分で読めます</span>
        </div>
        {tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li><a href={`/tags/${tag}/`} class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs text-gray-600 hover:bg-brand-50 hover:text-brand-700">#{tag}</a></li>
            ))}
          </ul>
        )}
      </header>

      {heroImage && (
        <img src={heroImage} alt="" width="1200" height="630" loading="eager" fetchpriority="high" decoding="async" class="mb-8 aspect-[40/21] w-full rounded-xl object-cover" />
      )}

      {toc.length > 2 && (
        <nav aria-label="目次" class="mb-10 rounded-xl border border-gray-200 bg-gray-50 p-5">
          <p class="mb-2 text-sm font-bold text-gray-900">目次</p>
          <ol class="space-y-1 text-sm">
            {toc.map((h) => (
              <li class:list={[h.depth === 3 && 'pl-4']}>
                <a href={`#${h.slug}`} class="text-gray-600 hover:text-brand-600">{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose prose-gray max-w-none prose-headings:scroll-mt-20 prose-h2:border-b prose-h2:border-gray-200 prose-h2:pb-2 prose-a:text-brand-600 prose-img:rounded-lg">
        <slot />
      </div>
    </article>

    {related.length > 0 && (
      <aside class="mt-16">
        <h2 class="mb-4 text-xl font-bold text-gray-900">関連記事</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </aside>
    )}
  </div>
</BaseLayout>
