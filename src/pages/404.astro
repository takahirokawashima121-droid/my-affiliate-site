---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません" noindex>
  <div class="py-16 text-center">
    <p class="text-6xl font-bold text-slate-500">404</p>
    <h1 class="mt-4 text-xl font-bold text-slate-100">ページが見つかりませんでした</h1>
    <p class="mt-2 text-slate-400">URLが変更されたか、削除された可能性があります。</p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-brand-600 px-6 py-3 font-bold text-slate-100 hover:bg-brand-700">トップページへ戻る</a>
  </div>
</BaseLayout>
