---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CardImage from '../../components/CardImage.astro';
import CardItem from '../../components/CardItem.astro';
import CardTags from '../../components/CardTags.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import { SALE_PRIMARY } from '../../utils/buttonStyles';
import AffiliatePixels from '../../components/AffiliatePixels.astro';
import MallSearchButtons from '../../components/MallSearchButtons.astro';
import CompareShopLinks from '../../components/CompareShopLinks.astro';
import { compareKeyword } from '../../config/compareShops';
import BuybackOptions from '../../components/BuybackOptions.astro';
import DecksUsingCard from '../../components/DecksUsingCard.astro';
import ToretokuNotice from '../../components/ToretokuNotice.astro';
import { cardSearchKeyword, nameWithRarity } from '../../utils/cardFormat';
import { moshimoClickUrl } from '../../utils/moshimo';
import { SITE, STANDARD_REGULATIONS } from '../../consts';
import { getCards, buybackLink, cardLabel, cardModel, cardPath, priceGap, showsBuybackPrice, mallOffers, bestOffer, formatDateTime, formatYen, isStandardLegal, isStandardExempt, hasRarityMark, sameNameVariants, cheapestVariantIds, productJsonLd, type Card } from '../../utils/cards';

export const getStaticPaths = (async () => {
  const cards = await getCards();
  const cheapestIds = cheapestVariantIds(cards);
  const byId = new Map(cards.map((c) => [c.id, c]));
  return cards.map((card) => {
    // 同じカード名の別レアリティ・別バージョン（安い順）
    const variants = sameNameVariants(card, cards);
    // 関連カード：同名カード（variants で別途表示）を除き、同じレアリティ → その他 の順に最大3件
    const related = cards
      .filter((c) => c.id !== card.id && c.data.name !== card.data.name)
      .sort((a, b) => Number(b.data.rarity === card.data.rarity) - Number(a.data.rarity === card.data.rarity))
      .slice(0, 3);
    // 予算を抑えたい場合の代用・関連カード（存在しない id は設定ミスなのでビルドを止める）
    const substitutes = (card.data.substituteIds ?? []).map((id) => {
      const sub = byId.get(id);
      if (!sub) throw new Error(`cards.json: ${card.id} の substituteIds に存在しない id「${id}」があります`);
      return sub;
    });
    return { params: { id: card.id }, props: { card, related, variants, substitutes, cheapestIds: [...cheapestIds] } };
  });
}) satisfies GetStaticPaths;

interface Props {
  card: Card;
  related: Card[];
  variants: Card[];
  substitutes: Card[];
  cheapestIds: string[];
}

const { card, related, variants, substitutes, cheapestIds } = Astro.props;
const isCheapest = (c: Card) => cheapestIds.includes(c.id);
const { name, rarity, cardNumber, expansionCode, imageUrl, saleInStock, saleShop, saleUrl, buybackPrice, updatedAt } = card.data;
// 買取ボタンの遷移先（カードごとの買取リンクを src/config/affiliate.ts で止めている間は古本市場（ふるいち）の宅配買取）
const buyback = buybackLink(card);
const label = cardLabel(card); // 例: ナンジャモ SAR [SV2D 096/071]
const model = cardModel(card); // 例: SV2D 096/071
const updatedText = formatDateTime(updatedAt);
const gap = priceGap(card); // 逆ザヤ（買取 ≧ 販売）の場合は差額・買取率を出さない
// 楽天市場・Yahoo!ショッピングの2大モール比較（best = 安い方。どちらも在庫なしなら null）
const offers = mallOffers(card);
const best = bestOffer(card);
const inStock = best !== null;
const mallPanels = [
  { key: 'rakuten', name: '楽天市場', offer: offers.rakuten, searchHref: saleUrl },
  { key: 'yahoo', name: 'Yahoo!ショッピング', offer: offers.yahoo, searchHref: moshimoClickUrl('yahoo', cardSearchKeyword(card.data)) },
] as const;
const isBest = (price: number) => best !== null && price === best.price; // 同額なら両方に「最安値」
const buybackShown = showsBuybackPrice(card); // 在庫なし（販売相場なし）なら買取額は「要査定」
const buybackUnverified = inStock && !gap.valid; // 在庫ありなのに逆ザヤ → 買取価格を「相場確認中」扱い
// 楽天市場の商品画像は、規約に沿って該当商品ページ（もしも経由）へのリンクと出典表記を付ける
const rakutenImage = saleInStock && saleShop === '楽天市場' && imageUrl.startsWith('https://thumbnail.image.rakuten.co.jp/');
const affiliateLinkProps = {
  href: saleUrl,
  target: '_blank',
  rel: 'sponsored nofollow noopener noreferrer',
  'data-aff-network': 'moshimo',
  'data-aff-shop': '楽天市場',
  'data-aff-item': label,
};

const title = `【ポケカ】${label}の販売最安値・買取相場比較`;
const saleSummary = best ? `${label}の販売最安値は${formatYen(best.price)}（${best.shop}）` : `${label}は楽天市場・Yahoo!ショッピングでは現在在庫なし。`;
const buybackSummary = buybackShown ? `買取目安は${formatYen(buybackPrice)}（販売価格をもとに当サイトが計算）。` : '買取価格はお店の査定でご確認ください。';
const description = `${saleSummary}${best ? '、' : ''}${buybackSummary}${updatedText}時点の楽天市場・Yahoo!ショッピングの販売価格を比較し、買取査定の申込先もまとめています。`;

// 構造化データ（Product ＋ AggregateOffer）。画像・在庫がないカードは出さない（null）
const jsonLd = productJsonLd(card, new URL(cardPath(card), Astro.site).toString(), description) ?? undefined;
---

<BaseLayout title={title} titleSuffix={false} description={description} image={imageUrl || undefined} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ name: 'ホーム（相場一覧）', href: '/' }, { name: label, href: cardPath(card) }]} />

  <article data-ga-item={card.data.name} class="grid gap-8 md:grid-cols-[minmax(0,280px)_1fr] lg:gap-12">
    <!-- 画像 -->
    <div class="mx-auto w-full max-w-[240px] md:max-w-none">
      {rakutenImage ? (
        <Fragment>
          <a {...affiliateLinkProps} data-aff-type="sale_image" class="block rounded-2xl transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" title="楽天市場の商品ページを開く（新しいタブ）">
            <CardImage card={card} eager sizes="(min-width: 768px) 280px, 240px" class="rounded-2xl shadow-lg" />
          </a>
          <p class="mt-2 text-center text-xs text-slate-600">
            画像出典: <a {...affiliateLinkProps} data-aff-type="sale_image_credit" class="underline hover:text-blue-600">楽天市場</a>
          </p>
        </Fragment>
      ) : (
        <CardImage card={card} eager sizes="(min-width: 768px) 280px, 240px" class="rounded-2xl shadow-lg" />
      )}
    </div>

    <div class="min-w-0">
      <p class="mb-4 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs leading-relaxed text-slate-600" role="note">{SITE.priceNotice}</p>

      <CardTags card={card} cheapest={isCheapest(card)} size="lg" />
      <h1 class="mt-2 text-2xl font-extrabold leading-tight text-slate-900 sm:text-3xl">
        {nameWithRarity(card.data)} <span class="font-mono text-xl font-bold text-slate-600 sm:text-2xl">[{model}]</span>
        <span class="mt-1 block text-base font-bold text-slate-600 sm:text-lg">販売最安値・買取相場比較</span>
      </h1>

      <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 rounded-xl border border-slate-200 bg-white p-4 text-sm">
        <dt class="text-slate-600">カード名</dt>
        <dd class="font-medium text-slate-900">{name}</dd>
        <dt class="text-slate-600">収録弾</dt>
        <dd class="font-mono text-slate-900">{expansionCode}</dd>
        <dt class="text-slate-600">カード番号</dt>
        <dd class="font-mono text-slate-900">{cardNumber}</dd>
        {card.data.regulationMark && (
          <Fragment>
            <dt class="text-slate-600">レギュレーション</dt>
            <dd class="text-slate-900">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded border-2 border-slate-200 font-mono text-xs font-extrabold">{card.data.regulationMark}</span>
              {isStandardLegal(card) ? (
                <span class="ml-2 text-xs font-bold text-emerald-600">スタンダードで使用可能{isStandardExempt(card) && !(card.data.regulationMark && (STANDARD_REGULATIONS as readonly string[]).includes(card.data.regulationMark)) && '（公式の例外カード）'}</span>
              ) : (
                <span class="ml-2 text-xs text-slate-600">スタンダードでは使用不可（エクストラ等）</span>
              )}
            </dd>
          </Fragment>
        )}
        <dt class="text-slate-600">レアリティ</dt>
        <dd class="font-medium text-slate-900">{hasRarityMark(rarity) ? rarity : '記号なし（再録カード）'}</dd>
        <dt class="text-slate-600">価格更新日時</dt>
        <dd class="text-slate-900"><time datetime={updatedAt.toISOString()}>{updatedText}</time></dd>
      </dl>

      <!-- 価格比較ボックス -->
      <section aria-labelledby="price-compare" class="mt-8">
        <h2 id="price-compare" class="mb-3 text-lg font-bold text-slate-900">販売・買取価格の比較</h2>
        {!inStock && (
          <div class="mb-4">
            <BuybackOptions card={card} heading="このカードを買取査定に出す" />
          </div>
        )}
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col rounded-2xl border-2 border-rose-300 bg-white p-5 shadow-sm">
            <p class="text-sm font-bold text-rose-600">販売最安値 <span class="text-xs font-medium text-slate-600">（楽天市場・Yahoo!ショッピング比較）</span></p>
            {best ? (
              <Fragment>
                <p class="mt-1 text-3xl font-extrabold tabular-nums text-rose-600 sm:text-4xl">{formatYen(best.price)}</p>
                <p class="mt-1 text-sm text-slate-600">最安ショップ：<span class="font-semibold text-slate-900">{best.shop}</span></p>
              </Fragment>
            ) : (
              <Fragment>
                <p class="mt-1 text-2xl font-extrabold text-slate-600 sm:text-3xl">在庫なし</p>
                <p class="mt-2 rounded-lg bg-slate-100 px-2 py-1 text-xs text-slate-600">{updatedText}時点で、楽天市場・Yahoo!ショッピングに在庫のある出品が見つかりませんでした。</p>
              </Fragment>
            )}
            <!-- モール別の価格（安い方に「最安値」ラベル。在庫のある側の購入ボタンを目立たせる） -->
            <ul class="mt-4 grid grid-cols-2 gap-2">
              {mallPanels.map((m) => (
                <li class:list={['flex flex-col rounded-xl border p-3', m.offer && isBest(m.offer.price) ? 'border-red-300 bg-red-50/60' : 'border-slate-200 bg-slate-50']}>
                  <p class="flex items-center justify-between gap-1 text-xs font-bold text-slate-700">
                    {m.name}
                    {m.offer && isBest(m.offer.price) && <span class="rounded-full bg-red-600 px-1.5 py-0.5 text-[10px] text-white">最安値</span>}
                  </p>
                  {m.offer ? (
                    <Fragment>
                      <p class="mt-1 text-lg font-extrabold tabular-nums text-slate-900">{formatYen(m.offer.price)}</p>
                      <a
                        href={m.offer.url}
                        target="_blank"
                        rel="sponsored nofollow noopener noreferrer"
                        data-aff-network="moshimo"
                        data-aff-shop={m.name}
                        data-aff-type="sale"
                        data-aff-item={label}
                        class:list={[
                          'mt-2 px-2 py-2 text-center text-sm font-bold leading-tight transition focus-visible:outline-2 focus-visible:outline-offset-2',
                          SALE_PRIMARY,
                        ]}
                      >
                        {isBest(m.offer.price) ? '最安値で購入する' : 'このショップで購入'}
                      </a>
                    </Fragment>
                  ) : (
                    <Fragment>
                      <p class="mt-1 text-base font-bold text-slate-600">在庫なし</p>
                      <a href={m.searchHref} target="_blank" rel="sponsored nofollow noopener noreferrer" data-aff-network="moshimo" data-aff-shop={m.name} data-aff-type="sale_search" data-aff-item={label} class="mt-2 text-center text-xs font-bold text-blue-600 hover:underline">出品を探す →</a>
                    </Fragment>
                  )}
                </li>
              ))}
            </ul>
          </div>
          <div class="flex flex-col rounded-2xl border-2 border-emerald-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-bold text-emerald-600">買取目安</p>
            {buybackShown ? (
              <p class="mt-1 text-3xl font-extrabold tabular-nums text-emerald-600 sm:text-4xl">{formatYen(buybackPrice)}</p>
            ) : (
              <p class="mt-1 text-2xl font-extrabold text-slate-600 sm:text-3xl">要査定</p>
            )}
            <p class="mt-1 text-xs leading-relaxed text-slate-600">{SITE.buybackEstimateNote}</p>
            {!buybackShown && <p class="mt-2 rounded-lg bg-slate-100 px-2 py-1 text-xs text-slate-600">販売相場がないため買取目安を表示していません。買取価格はショップの査定でご確認ください。</p>}
            {buybackUnverified && <p class="mt-2 rounded-lg bg-amber-50 px-2 py-1 text-xs text-amber-800">相場確認中：最新の買取価格はショップでご確認ください</p>}
            <div class="mt-4">
              <AffiliateButton kind="buyback" href={buyback.url} shop={buyback.shop} size="lg" item={label} />
            </div>
          </div>
        </div>

        {inStock && (
          <div class="mt-6">
            <BuybackOptions card={card} />
          </div>
        )}

        <MallSearchButtons keyword={cardSearchKeyword(card.data)} shopKeyword={compareKeyword(card.data)} />
        <CompareShopLinks keyword={compareKeyword(card.data)} />

        <p class="mt-4 rounded-xl bg-slate-100 px-4 py-3 text-sm text-slate-700">
          {gap.valid ? (
            <Fragment>販売価格と買取価格の差額は <strong class="tabular-nums">{formatYen(gap.spread)}</strong>（買取率 約<strong class="tabular-nums">{gap.rate}%</strong>）です。</Fragment>
          ) : inStock ? (
            <Fragment>販売価格と買取価格の差額・買取率は<strong>相場確認中</strong>です。</Fragment>
          ) : (
            <Fragment>楽天市場・Yahoo!ショッピングに在庫がないため、差額・買取率は表示していません。</Fragment>
          )}
        </p>

        <p class="mt-4 flex gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs leading-relaxed text-slate-600" role="note">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path stroke-linecap="round" d="M12 8h.01M11 12h1v4h1"></path>
          </svg>
          <span>価格は変動するため、最新の在庫状況・価格は各公式サイトにてご確認ください。</span>
        </p>
      </section>

      {substitutes.length > 0 && (
        <section aria-labelledby="substitutes" class="mt-8 rounded-2xl border border-emerald-200 bg-emerald-50 p-5">
          <h2 id="substitutes" class="text-lg font-bold text-slate-900">💰 予算を抑えたい場合の代用・関連カード</h2>
          <p class="mt-1 text-xs text-slate-600">
            役割が近く、より安く手に入るカードです。効果はまったく同じではないため、デッキに合わせて選んでください。
          </p>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {substitutes.map((sub) => (
              <li>
                <a href={cardPath(sub)} class="group flex items-center gap-3 rounded-xl border border-emerald-200 bg-white p-3 transition hover:border-blue-400 hover:shadow-sm">
                  <div class="w-14 shrink-0">
                    <CardImage card={sub} sizes="56px" />
                  </div>
                  <div class="min-w-0 flex-1">
                    <CardTags card={sub} cheapest={isCheapest(sub)} />
                    <p class="mt-1 text-sm font-bold leading-snug text-slate-900 group-hover:text-blue-600">{nameWithRarity(sub.data)}</p>
                    <p class="font-mono text-xs text-slate-600">[{cardModel(sub)}]</p>
                  </div>
                  <div class="shrink-0 text-right">
                    <p class="text-[11px] text-slate-600">販売最安値</p>
                    {bestOffer(sub) ? (
                      <p class="text-base font-extrabold tabular-nums text-rose-600">{formatYen(bestOffer(sub)!.price)}</p>
                    ) : (
                      <p class="text-sm font-bold text-slate-600">在庫なし</p>
                    )}
                    <p class="text-xs font-medium text-blue-600">詳細 →</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {variants.length > 0 && (
        <section aria-labelledby="variants" class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-5">
          <h2 id="variants" class="text-lg font-bold text-slate-900">別レアリティ・別バージョンの相場を見る</h2>
          <p class="mt-1 text-xs text-slate-600">
            「{name}」はほかに{variants.length}種類掲載しています。{isCheapest(card) && <strong class="text-amber-700">このカードが同名カードの中で最安版です。</strong>}
            同じ名前でも収録弾によってワザや特性が異なる場合があります。
          </p>
          <ul class="mt-4 divide-y divide-amber-200">
            {variants.map((v) => (
              <li>
                <a href={cardPath(v)} class="group flex flex-wrap items-center gap-x-3 gap-y-1 py-3 hover:bg-amber-50 sm:flex-nowrap">
                  <CardTags card={v} cheapest={isCheapest(v)} />
                  <span class="min-w-0 flex-1 text-sm font-bold text-slate-900 group-hover:text-blue-600">
                    {nameWithRarity(v.data)} <span class="font-mono text-xs font-semibold text-slate-600">[{cardModel(v)}]</span>
                  </span>
                  <span class="text-sm font-extrabold tabular-nums">
                    {bestOffer(v) ? <span class="text-rose-600">{formatYen(bestOffer(v)!.price)}</span> : <span class="text-slate-600">在庫なし</span>}
                  </span>
                  <span class="text-xs font-medium text-blue-600">相場を見る →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <DecksUsingCard card={card} />

      <!-- 価格比較・買取目安の欄とは別の場所に小さく置く（ほかのショップと並べない） -->
      <ToretokuNotice variant="card" item={label} />

      <a href="/" class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-blue-600 hover:underline">← 相場一覧（トップページ）に戻る</a>
    </div>
  </article>

  {related.length > 0 && (
    <section aria-labelledby="related" class="mt-16">
      <h2 id="related" class="mb-5 text-xl font-bold text-slate-900">ほかのカードの相場</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((c) => <CardItem card={c} cheapest={isCheapest(c)} />)}
      </div>
    </section>
  )}

  <AffiliatePixels cards={[card, ...related]} shops={['furuichi', 'beehonpo']} />
</BaseLayout>
