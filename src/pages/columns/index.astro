---
// デッキ解説コラムの一覧（src/data/deck-columns.json の記事を新しい順に表示）
// 上部のタブでカテゴリを絞り込める（JS でカードの表示を切り替え、URL の ?filter= にも反映。JS なしでも全件表示）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CardImage from '../../components/CardImage.astro';
import EventBadge from '../../components/EventBadge.astro';
import { DECK_COLUMNS, columnPath, eventTypeOf } from '../../data/deck-columns';
import { formatYen, getCards } from '../../utils/cards';
import { DECK_FILTERS, BUDGET_LIMIT, deckBadgeClass, deckSummary } from '../../utils/decks';

const cards = await getCards();
const columns = DECK_COLUMNS.map((c, i) => ({ ...c, ...deckSummary(c, cards), event: eventTypeOf(c) ?? 'other', order: i }))
  // 新しい順（同じ日なら登録順）
  .sort((a, b) => b.pubDate.localeCompare(a.pubDate) || a.order - b.order);
// 大会の種類で絞り込むタブ（カテゴリのタブと組み合わせて使える）
const EVENT_FILTERS = [
  { key: 'all', label: 'すべての大会' },
  { key: 'city', label: '🏆 シティリーグ' },
  { key: 'gym', label: '⚔️ ジムバトル' },
] as const;
const eventCounts = Object.fromEntries(EVENT_FILTERS.map((f) => [f.key, f.key === 'all' ? columns.length : columns.filter((c) => c.event === f.key).length]));
const counts = Object.fromEntries(DECK_FILTERS.map((f) => [f.key, f.key === 'all' ? columns.length : columns.filter((c) => c.categories.includes(f.key as never)).length]));

const title = 'デッキ解説コラム一覧';
const description = 'ジムバトルなどで結果を残した現行スタンダードのデッキを、60枚レシピ・回し方・採用カードの最安値つきで解説するコラムの一覧です。';
// シティリーグは濃紺×ゴールド、それ以外はアンバーで選択中を示す
const eventTab =
  'event-filter shrink-0 rounded-full border px-3.5 py-1.5 text-sm font-bold transition border-slate-300 bg-white text-slate-700 hover:border-slate-500 aria-pressed:border-slate-900 aria-pressed:bg-slate-900 aria-pressed:text-amber-300 aria-pressed:shadow-sm';
const tab =
  'deck-filter shrink-0 rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-slate-300 bg-white text-slate-600 hover:border-blue-400 hover:text-blue-600 aria-pressed:border-amber-500 aria-pressed:bg-amber-500/90 aria-pressed:font-black aria-pressed:text-slate-950 aria-pressed:shadow-sm';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-5xl">
    <Breadcrumbs items={[{ name: 'ホーム', href: '/' }, { name: 'デッキ解説', href: '/columns/' }]} />
    <h1 class="text-xl font-bold text-slate-900 sm:text-3xl">{title}</h1>
    <p class="mt-2 text-xs leading-relaxed text-slate-600 sm:text-sm">{description}</p>

    <div class="mt-6" role="group" aria-label="大会の種類で絞り込む">
      <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0">
        {EVENT_FILTERS.map((f, i) => (
          <button type="button" class={eventTab} data-event={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}<span class="ml-1 text-xs tabular-nums opacity-70">{eventCounts[f.key]}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="mt-3" role="group" aria-label="デッキの種類で絞り込む">
      <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0">
        {DECK_FILTERS.map((f, i) => (
          <button type="button" class={tab} data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}<span class="ml-1 text-xs tabular-nums opacity-70">{counts[f.key]}</span>
          </button>
        ))}
      </div>
      <p class="mt-2 text-xs text-slate-600">
        「非ex / 低予算」は、主役が ex 以外のデッキと、60枚の概算が{formatYen(BUDGET_LIMIT)}未満のデッキです。<span id="deck-count" aria-live="polite"></span>
      </p>
    </div>

    <ul class="mt-4 grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3" id="deck-list">
      {columns.map((c) => (
        <li class="deck-item" data-categories={c.categories.join(' ')} data-event={c.event}>
          <!-- Tier表のカードと同じ構造：上部（画像・タイトル・見どころ）は可変、下部ブロックは mt-auto で下端に寄せ、価格はボタンの直上に固定 -->
          <!-- カード全体が1つのリンクのため、ボタンは <a> の入れ子にせず見た目だけのボタン（span）にする -->
          <a href={columnPath(c)} class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-3 shadow-sm transition hover:border-blue-400 hover:shadow-md sm:p-4">
            <span class="flex gap-3 pb-4">
              {c.mainCard && <span class="block w-20 shrink-0 self-start sm:w-24"><CardImage card={c.mainCard} sizes="96px" class="border border-slate-200" /></span>}
              <span class="flex min-w-0 flex-1 flex-col">
                <span><EventBadge column={c} /></span>
                <span class="mt-1 text-base font-black leading-snug text-slate-900 group-hover:text-blue-600">{c.deckName}</span>
                <span class="mt-0.5 line-clamp-2 text-xs leading-relaxed text-slate-600">{c.highlight}</span>
              </span>
            </span>
            <span class="mt-auto flex flex-col gap-3 border-t border-slate-100 pt-4">
              <span class="flex items-end justify-between gap-2">
                <span class="flex shrink-0 flex-col justify-end">
                  <span class="text-[11px] font-medium text-slate-600">60枚の最安パーツ概算</span>
                  <span class="text-xl font-black leading-tight tabular-nums text-rose-600">{c.estimate > 0 ? formatYen(c.estimate) : '集計中'}</span>
                </span>
                <span class="flex min-w-0 flex-col items-end text-right">
                  <span class="text-[11px] font-medium text-slate-600">デッキタイプ</span>
                  <span class="mt-1 flex flex-wrap justify-end gap-1">
                    {c.badges.map((b) => <span class={`whitespace-nowrap rounded-full px-2 py-0.5 text-[10px] font-bold ${deckBadgeClass(b)}`}>{b}</span>)}
                  </span>
                </span>
              </span>
              <span class="flex w-full items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-black text-white shadow-sm transition group-hover:bg-blue-700">
                レシピ・最安パーツを見る →
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p id="deck-empty" class="mt-6 rounded-xl bg-white p-6 text-center text-sm text-slate-600" hidden>該当するデッキ解説はまだありません。</p>

    <p class="mt-10 text-sm text-slate-600">
      カードの買い方・売り方のコラムは <a href="/blog/" class="text-blue-600 underline">コラム一覧</a> をご覧ください。
    </p>
  </div>
</BaseLayout>

<script>
  // 絞り込み：大会の種類（?event=city など）とデッキのカテゴリ（?filter=mega など）の AND 条件。URL でも開ける
  const eventButtons = [...document.querySelectorAll<HTMLButtonElement>('.event-filter')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.deck-filter')];
  const items = [...document.querySelectorAll<HTMLElement>('.deck-item')];
  const count = document.getElementById('deck-count');
  const empty = document.getElementById('deck-empty');
  const eventKeys = eventButtons.map((b) => b.dataset.event ?? 'all');
  const keys = buttons.map((b) => b.dataset.filter ?? 'all');
  const state = { event: 'all', filter: 'all' };

  const apply = (updateUrl: boolean) => {
    let shown = 0;
    for (const item of items) {
      const match =
        (state.event === 'all' || item.dataset.event === state.event) &&
        (state.filter === 'all' || (item.dataset.categories ?? '').split(' ').includes(state.filter));
      item.hidden = !match;
      if (match) shown++;
    }
    for (const b of eventButtons) b.setAttribute('aria-pressed', String(b.dataset.event === state.event));
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === state.filter));
    const filtered = state.event !== 'all' || state.filter !== 'all';
    if (count) count.textContent = filtered ? `（${items.length}件中 ${shown}件を表示）` : '';
    if (empty) empty.hidden = shown > 0;
    if (updateUrl) {
      const url = new URL(location.href);
      for (const key of ['event', 'filter'] as const) {
        if (state[key] === 'all') url.searchParams.delete(key);
        else url.searchParams.set(key, state[key]);
      }
      history.replaceState(null, '', url);
    }
  };

  for (const b of eventButtons) b.addEventListener('click', () => ((state.event = b.dataset.event ?? 'all'), apply(true)));
  for (const b of buttons) b.addEventListener('click', () => ((state.filter = b.dataset.filter ?? 'all'), apply(true)));
  const params = new URLSearchParams(location.search);
  const initialEvent = params.get('event');
  const initialFilter = params.get('filter');
  if (initialEvent && eventKeys.includes(initialEvent)) state.event = initialEvent;
  if (initialFilter && keys.includes(initialFilter)) state.filter = initialFilter;
  if (state.event !== 'all' || state.filter !== 'all') apply(false);
</script>
