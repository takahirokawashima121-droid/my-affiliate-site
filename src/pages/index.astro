---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardItem from '../components/CardItem.astro';
import AffiliatePixels from '../components/AffiliatePixels.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedDecks from '../components/FeaturedDecks.astro';
import { DECK_COLUMNS } from '../data/deck-columns';
import { TIER_LIST } from '../data/tier';
import { SITE, STANDARD_REGULATIONS } from '../consts';
import { getCards, getRarities, latestUpdate, formatDateTime, cardPath, cardLabel, cardModel, cheapestVariantIds, bestOffer, hasSaleStock } from '../utils/cards';
import { getPosts } from '../utils/posts';

const cards = await getCards();
const rarities = getRarities(cards);
const cheapestIds = cheapestVariantIds(cards); // 同名カードが複数あるときの最安版
const updated = latestUpdate(cards);
const posts = (await getPosts()).slice(0, 6);
// 環境Tier表への導線に出す Tier1・Tier2 のデッキ名
const tierPreview = TIER_LIST.tiers.slice(0, 2).map((t) => ({ label: t.label, rank: t.rank, names: t.decks.map((d) => DECK_COLUMNS.find((c) => c.slug === d.slug)?.deckName ?? d.slug) }));

// 構造化データ：サイト情報 + 掲載カード一覧（商品と最安値）
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    description: SITE.description,
    url: Astro.site?.toString(),
    inLanguage: SITE.lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '現行スタンダード（H・I・J）デッキパーツ一覧',
    numberOfItems: cards.length,
    itemListElement: cards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: cardLabel(c),
        sku: cardModel(c),
        url: new URL(cardPath(c), Astro.site).toString(),
        brand: { '@type': 'Brand', name: 'ポケモンカードゲーム' },
        ...(c.data.imageUrl && { image: new URL(c.data.imageUrl, Astro.site).toString() }),
        // 2大モールの最安値。どちらも在庫なしのカードは価格情報（Offer）を出さない
        ...(bestOffer(c) && {
          offers: {
            '@type': 'Offer',
            price: bestOffer(c)!.price,
            priceCurrency: 'JPY',
            seller: { '@type': 'Organization', name: bestOffer(c)!.shop },
            url: bestOffer(c)!.url,
          },
        }),
      },
    })),
  },
];

const chip =
  'filter-chip rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-slate-600 bg-slate-900 text-slate-400 hover:border-sky-500/60 hover:text-sky-400 aria-pressed:border-amber-500/70 aria-pressed:bg-amber-500/90 aria-pressed:font-black aria-pressed:text-slate-950 aria-pressed:shadow-md aria-pressed:hover:border-amber-500/70 aria-pressed:hover:text-slate-950';
---

<BaseLayout jsonLd={jsonLd}>
  <!-- ヒーロー：現行スタンダード（H・I・J）で対戦するプレイヤー向けのデッキ研究＆パーツ調達工房 -->
  <section class="bg-lab-panel lab-corners relative mb-8 overflow-hidden rounded-2xl border border-lab-600 px-5 py-8 text-slate-100 shadow-xl shadow-black/25 sm:px-10 sm:py-12">
    <!-- 装飾：工房の歯車（計器のシアン・作業灯のアンバー） -->
    <svg class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 text-lamp/15 sm:-right-6 sm:-top-6 sm:h-64 sm:w-64 sm:text-lamp/20" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" aria-hidden="true">
      <path d="M50 8v12M50 80v12M8 50h12M80 50h12M20.3 20.3l8.5 8.5M71.2 71.2l8.5 8.5M20.3 79.7l8.5-8.5M71.2 28.8l8.5-8.5" stroke-linecap="square" stroke-width="9"></path>
      <circle cx="50" cy="50" r="28"></circle>
      <circle cx="50" cy="50" r="11"></circle>
    </svg>
    <svg class="pointer-events-none absolute bottom-6 right-24 hidden h-20 w-20 text-gauge/20 sm:block" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="6" aria-hidden="true">
      <path d="M50 10v14M50 76v14M10 50h14M76 50h14M21.7 21.7l9.9 9.9M68.4 68.4l9.9 9.9M21.7 78.3l9.9-9.9M68.4 31.6l9.9-9.9" stroke-linecap="square" stroke-width="10"></path>
      <circle cx="50" cy="50" r="24"></circle>
    </svg>

    <ul class="relative flex flex-wrap gap-2" aria-label="対象">
      <li class="spec-tag border-lamp/70 bg-lamp/10 text-lamp">競技プレイヤー専用</li>
      <li class="spec-tag border-gauge/60 bg-gauge/10 text-gauge">現行レギュレーション H・I・J 特化</li>
    </ul>
    <h1 class="relative mt-4 text-3xl font-black tracking-tight sm:text-5xl">
      {SITE.title}
      <span class="mt-2 block h-1 w-24 bg-hazard sm:w-32" aria-hidden="true"></span>
    </h1>
    <p class="relative mt-4 max-w-2xl text-base font-bold leading-relaxed text-slate-100 sm:text-xl">バトルに勝つためのデッキ研究＆パーツ調達サポートサイト</p>

    <!-- 当工房の特徴 -->
    <h2 class="relative mt-8 font-mono text-[11px] font-bold tracking-widest text-slate-400">当工房の特徴 / FEATURES</h2>
    <ul class="relative mt-2 grid gap-3 md:grid-cols-3">
      {[
        { icon: '🛠️', no: '01', title: 'ジムバトル優勝レシピの分析', body: '勝率を高める60枚の採用理由と立ち回りを研究' },
        { icon: '⚡', no: '02', title: '最安パーツ一括調達', body: '不足しているカードの最安値をショップ横断で即時チェック' },
        { icon: '🛡️', no: '03', title: 'スタン落ち完全排除', body: 'H・I・J規格のみ掲載。使えないカードを買ってしまう事故を防止' },
      ].map((f) => (
        <li class="rounded-lg border border-lab-600 bg-lab-800/80 p-4">
          <span class="flex items-center justify-between">
            <span class="text-2xl" aria-hidden="true">{f.icon}</span>
            <span class="font-mono text-[10px] font-bold tracking-widest text-slate-400">SPEC-{f.no}</span>
          </span>
          <span class="mt-2 block text-sm font-black text-lamp sm:text-base">{f.title}</span>
          <span class="mt-1 block text-xs leading-relaxed text-slate-300 sm:text-sm">{f.body}</span>
        </li>
      ))}
    </ul>

    <p class="relative mt-6 border-l-2 border-lamp/70 pl-3 text-xs leading-relaxed text-slate-300 sm:text-sm">
      ※当サイトは対戦プレイヤー専用のデッキ構築サポートサイトです。レアリティ相場・投資・PSA価値の追跡は一切行いません。実戦に必要な最安パーツを無駄なく揃えたいプレイヤーのために設計されています。
    </p>
    <p class="relative mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] text-slate-400">
      <span>PARTS: <span class="font-bold tabular-nums text-gauge">{cards.length}</span>種</span>
      <span>UPDATED: <span class="text-slate-300">{updated ? formatDateTime(updated) : '-'}</span></span>
    </p>
  </section>

  <!-- 環境Tier表への導線 -->
  <a href="/tier/" class="bg-lab-panel group mb-8 block rounded-2xl border border-lab-600 p-4 text-slate-100 shadow-lg shadow-black/20 transition hover:-translate-y-0.5 hover:border-lamp/60 sm:p-6">
    <span class="flex flex-wrap items-center justify-between gap-2">
      <span class="text-lg font-black sm:text-xl"><span aria-hidden="true">📊</span> 最新環境Tier表（H・I・J）</span>
      <span class="font-mono text-[11px] text-slate-400">{TIER_LIST.updated.replaceAll('-', '/')} 更新・5サイトの評価を独自分析</span>
    </span>
    <span class="mt-3 block space-y-2">
      {tierPreview.map((t) => (
        <span class="flex items-start gap-2 text-xs sm:text-sm">
          <span class:list={['spec-tag shrink-0', t.rank === 1 ? 'border-lamp bg-lamp/90 text-slate-950' : 'border-gauge/70 bg-gauge/10 text-gauge']}>{t.label}</span>
          <span class="text-slate-200">{t.names.join(' ／ ')}</span>
        </span>
      ))}
    </span>
    <span class="mt-4 block text-right text-sm font-black text-lamp group-hover:underline">Tier1〜3の全デッキとレシピを見る →</span>
  </a>

  <FeaturedDecks cards={cards} />

  <p class="mb-6 rounded-lg border border-slate-700/60 bg-slate-900 px-4 py-3 text-xs leading-relaxed text-slate-400 sm:text-sm" role="note">{SITE.priceNotice}</p>

  <!-- 検索・絞り込み・並び替え -->
  <section aria-labelledby="price-list">
    <h2 id="price-list" class="sr-only">デッキパーツ検索</h2>
    <div class="mb-6 space-y-4 rounded-2xl border border-slate-700/60 bg-slate-900 p-4 shadow-sm sm:p-5">
      <div class="flex flex-col gap-3 sm:flex-row">
        <label class="relative flex-1">
          <span class="sr-only">カード名・型番・レアリティで検索</span>
          <svg class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path stroke-linecap="round" d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            id="card-search"
            type="search"
            placeholder="使いたいカード名を入力（例: なかよしポフィン、オーガポン）"
            autocomplete="off"
            class="w-full rounded-xl border border-slate-600 bg-slate-800/60 py-3 pl-10 pr-3 text-base outline-none transition placeholder:text-slate-500 focus:border-sky-500 focus:bg-slate-900 focus:ring-2 focus:ring-sky-500/30"
          />
        </label>
        <label class="flex items-center gap-2 sm:w-56">
          <span class="shrink-0 text-sm text-slate-400">並び替え</span>
          <select
            id="card-sort"
            class="w-full rounded-xl border border-slate-600 bg-slate-900 px-3 py-3 text-base outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/30"
          >
            <option value="new">新着順</option>
            <option value="sale-asc">販売が安い順</option>
            <option value="buyback-desc">買取が高い順</option>
          </select>
        </label>
      </div>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="レアリティで絞り込み">
        <span class="mr-1 w-full text-sm text-slate-400 sm:w-auto">レアリティ:</span>
        <button type="button" class={chip} data-filter="rarity" data-value="" aria-pressed="true">すべて</button>
        {rarities.map((r) => <button type="button" class={chip} data-filter="rarity" data-value={r} aria-pressed="false">{r === '-' ? '記号なし' : r}</button>)}
      </div>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="レギュレーションで絞り込み">
        <span class="mr-1 w-full text-sm text-slate-400 sm:w-auto">レギュレーション:</span>
        <button type="button" class={chip} data-filter="regulation" data-value="" aria-pressed="true">すべて</button>
        {STANDARD_REGULATIONS.map((m) => <button type="button" class={chip} data-filter="regulation" data-value={m} aria-pressed="false">{m}</button>)}
        <span class="ml-1 inline-flex items-center gap-1 text-xs text-emerald-400"><span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>H・I・J はスタンダードで使用可能</span>
      </div>
    </div>

    <p class="mb-4 text-sm text-slate-400" aria-live="polite">
      <span id="card-count">{cards.length}</span>件のカードを表示中
    </p>

    <div id="card-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card, i) => <CardItem card={card} eager={i < 3} cheapest={cheapestIds.has(card.id)} />)}
    </div>

    <div id="card-empty" class="hidden rounded-2xl border border-dashed border-slate-600 py-16 text-center text-slate-400">
      <p class="font-medium">該当するカードが見つかりませんでした</p>
      <p class="mt-1 text-sm">キーワードやレアリティを変えてお試しください。</p>
    </div>

    <AffiliatePixels cards={cards} shops={cards.some((c) => !hasSaleStock(c)) ? ['furuichi'] : []} />

    <p class="mt-6 text-xs leading-relaxed text-slate-400">
      ※ 価格は各ショップの掲載情報をもとにした参考価格です。在庫状況や状態（美品・傷あり等）により実際の価格は変動します。購入・買取の前に必ず各ショップで最新情報をご確認ください。
    </p>
  </section>

  {posts.length > 0 && (
    <section aria-labelledby="columns" class="mt-16">
      <div class="mb-6 flex items-end justify-between">
        <h2 id="columns" class="text-xl font-bold text-slate-100">デッキ研究コラム</h2>
        <a href="/blog/" class="text-sm text-sky-400 hover:underline">コラム一覧を見る →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="mt-8 text-center">
        <a href="/blog/" class="inline-block rounded-xl border border-sky-500 px-6 py-3 text-sm font-bold text-sky-400 transition hover:bg-blue-600 hover:text-slate-100">コラム一覧をすべて見る</a>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const grid = document.getElementById('card-grid')!;
  const input = document.getElementById('card-search') as HTMLInputElement;
  // ほかのページのボトムナビ「カード検索」（/#card-search）から来たときは検索欄を画面中央に出してフォーカス
  if (location.hash === '#card-search') {
    input.scrollIntoView({ block: 'center' });
    input.focus({ preventScroll: true });
  }
  const sortSelect = document.getElementById('card-sort') as HTMLSelectElement;
  const countEl = document.getElementById('card-count')!;
  const emptyEl = document.getElementById('card-empty')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter-chip')];
  const items = [...grid.querySelectorAll<HTMLElement>('.card-item')];

  // 全角/半角・大文字/小文字・ひらがな/カタカナの違いを吸収して検索
  const normalize = (s: string) =>
    s
      .normalize('NFKC')
      .toLowerCase()
      .replace(/[ぁ-ゖ]/g, (c) => String.fromCharCode(c.charCodeAt(0) + 0x60))
      .replace(/\s+/g, ' ')
      .trim();

  const index = new Map(items.map((el) => [el, normalize(el.dataset.search ?? '')]));
  // 絞り込み条件（レアリティ・レギュレーション・キーワードはすべて AND 条件）
  const filters: Record<string, string> = { rarity: '', regulation: '' };

  const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    new: (a, b) => Number(b.dataset.updated) - Number(a.dataset.updated),
    // 在庫なし（data-sale が空）は最後に並べる
    'sale-asc': (a, b) => (a.dataset.sale ? Number(a.dataset.sale) : Infinity) - (b.dataset.sale ? Number(b.dataset.sale) : Infinity),
    // 要査定（data-buyback が空）は最後に並べる
    'buyback-desc': (a, b) => (b.dataset.buyback ? Number(b.dataset.buyback) : -Infinity) - (a.dataset.buyback ? Number(a.dataset.buyback) : -Infinity),
  };

  function update() {
    const terms = normalize(input.value).split(' ').filter(Boolean);
    let visible = 0;
    for (const el of items) {
      const text = index.get(el)!;
      const show =
        (!filters.rarity || el.dataset.rarity === filters.rarity) &&
        (!filters.regulation || el.dataset.regulation === filters.regulation) &&
        terms.every((t) => text.includes(t));
      el.hidden = !show;
      if (show) visible++;
    }
    grid.append(...[...items].sort(sorters[sortSelect.value] ?? sorters.new));
    countEl.textContent = String(visible);
    emptyEl.classList.toggle('hidden', visible > 0);
  }

  input.addEventListener('input', update);
  sortSelect.addEventListener('change', update);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const group = chip.dataset.filter ?? '';
      filters[group] = chip.dataset.value ?? '';
      for (const c of chips) if (c.dataset.filter === group) c.setAttribute('aria-pressed', String(c === chip));
      update();
    });
  }
  // ブラウザの「戻る」で入力値が復元された場合にも反映
  update();
</script>
