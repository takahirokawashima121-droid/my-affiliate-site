---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardItem from '../components/CardItem.astro';
import AffiliatePixels from '../components/AffiliatePixels.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, STANDARD_REGULATIONS } from '../consts';
import { getCards, getRarities, latestUpdate, formatDateTime, cardPath, cardLabel, cardModel, cheapestVariantIds } from '../utils/cards';
import { getPosts } from '../utils/posts';

const cards = await getCards();
const rarities = getRarities(cards);
const cheapestIds = cheapestVariantIds(cards); // 同名カードが複数あるときの最安版
const shops = new Set(cards.flatMap((c) => [c.data.saleShop, c.data.buybackShop]));
const updated = latestUpdate(cards);
const posts = (await getPosts()).slice(0, 6);

// 構造化データ：サイト情報 + 掲載カード一覧（商品と最安値）
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    description: SITE.description,
    url: Astro.site?.toString(),
    inLanguage: SITE.lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'ポケモンカード 販売・買取価格一覧',
    numberOfItems: cards.length,
    itemListElement: cards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: cardLabel(c),
        sku: cardModel(c),
        url: new URL(cardPath(c), Astro.site).toString(),
        brand: { '@type': 'Brand', name: 'ポケモンカードゲーム' },
        ...(c.data.imageUrl && { image: new URL(c.data.imageUrl, Astro.site).toString() }),
        // 在庫なしのカードは価格情報（Offer）を出さない
        ...(c.data.saleInStock && {
          offers: {
            '@type': 'Offer',
            price: c.data.salePrice,
            priceCurrency: 'JPY',
            seller: { '@type': 'Organization', name: c.data.saleShop },
            url: c.data.saleUrl,
          },
        }),
      },
    })),
  },
];

const chip =
  'filter-chip rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-slate-300 bg-white text-slate-600 hover:border-blue-400 hover:text-blue-600 aria-pressed:border-amber-400 aria-pressed:bg-amber-400 aria-pressed:font-bold aria-pressed:text-slate-900 aria-pressed:shadow-sm aria-pressed:hover:border-amber-400 aria-pressed:hover:text-slate-900';
---

<BaseLayout jsonLd={jsonLd}>
  <!-- ヒーロー -->
  <section class="relative mb-8 overflow-hidden rounded-3xl bg-gradient-to-r from-blue-600 via-blue-500 to-sky-400 px-6 py-10 text-white shadow-lg shadow-blue-500/20 sm:px-10 sm:py-14">
    <!-- 装飾：モンスターボール風のアクセント -->
    <svg class="pointer-events-none absolute -right-10 -top-10 h-56 w-56 opacity-30 sm:-right-6 sm:h-72 sm:w-72 sm:opacity-40" viewBox="0 0 100 100" aria-hidden="true">
      <circle cx="50" cy="50" r="46" fill="#fff"></circle>
      <path d="M4 50a46 46 0 0 1 92 0z" fill="#ef4444"></path>
      <rect x="4" y="46" width="92" height="8" fill="#0f172a"></rect>
      <circle cx="50" cy="50" r="14" fill="#0f172a"></circle>
      <circle cx="50" cy="50" r="8" fill="#fff"></circle>
    </svg>
    <div class="pointer-events-none absolute -bottom-16 right-40 h-40 w-40 rounded-full bg-white/15" aria-hidden="true"></div>
    <p class="relative text-xs font-bold tracking-widest text-amber-300">POKEMON CARD PRICE COMPARISON</p>
    <h1 class="relative mt-2 text-2xl font-extrabold leading-tight [text-shadow:0_2px_8px_rgb(30_58_138/0.35)] sm:text-4xl">
      中古ポケカの<span class="whitespace-nowrap text-amber-300">販売最安値</span>と<span class="whitespace-nowrap text-amber-300">買取最高値</span>を<br class="hidden sm:inline" />ひと目で比較
    </h1>
    <p class="relative mt-4 max-w-2xl text-sm text-blue-50 sm:text-base">{SITE.description}</p>
    <dl class="relative mt-8 grid max-w-xl grid-cols-3 gap-3 text-center">
      <div class="rounded-xl bg-white/20 px-2 py-3 ring-1 ring-white/40 backdrop-blur">
        <dt class="text-[11px] font-medium text-blue-50">掲載カード</dt>
        <dd class="text-xl font-bold sm:text-2xl">{cards.length}<span class="text-sm font-normal">種</span></dd>
      </div>
      <div class="rounded-xl bg-white/20 px-2 py-3 ring-1 ring-white/40 backdrop-blur">
        <dt class="text-[11px] font-medium text-blue-50">比較ショップ</dt>
        <dd class="text-xl font-bold sm:text-2xl">{shops.size}<span class="text-sm font-normal">店</span></dd>
      </div>
      <div class="rounded-xl bg-white/20 px-2 py-3 ring-1 ring-white/40 backdrop-blur">
        <dt class="text-[11px] font-medium text-blue-50">最終更新</dt>
        <dd class="mt-1 text-xs font-bold sm:text-sm">{updated ? formatDateTime(updated) : '-'}</dd>
      </div>
    </dl>
  </section>

  <p class="mb-6 rounded-lg border border-slate-200 bg-white px-4 py-3 text-xs leading-relaxed text-slate-600 sm:text-sm" role="note">{SITE.priceNotice}</p>

  <!-- 検索・絞り込み・並び替え -->
  <section aria-labelledby="price-list">
    <h2 id="price-list" class="sr-only">カード価格一覧</h2>
    <div class="mb-6 space-y-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
      <div class="flex flex-col gap-3 sm:flex-row">
        <label class="relative flex-1">
          <span class="sr-only">カード名・型番・レアリティで検索</span>
          <svg class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path stroke-linecap="round" d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            id="card-search"
            type="search"
            placeholder="カード名・型番・レアリティで検索（例：なんじゃも、SAR）"
            autocomplete="off"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 py-3 pl-10 pr-3 text-base outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200"
          />
        </label>
        <label class="flex items-center gap-2 sm:w-56">
          <span class="shrink-0 text-sm text-slate-500">並び替え</span>
          <select
            id="card-sort"
            class="w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-base outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
          >
            <option value="new">新着順</option>
            <option value="sale-asc">販売が安い順</option>
            <option value="buyback-desc">買取が高い順</option>
          </select>
        </label>
      </div>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="レアリティで絞り込み">
        <span class="mr-1 w-full text-sm text-slate-500 sm:w-auto">レアリティ:</span>
        <button type="button" class={chip} data-filter="rarity" data-value="" aria-pressed="true">すべて</button>
        {rarities.map((r) => <button type="button" class={chip} data-filter="rarity" data-value={r} aria-pressed="false">{r}</button>)}
      </div>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="レギュレーションで絞り込み">
        <span class="mr-1 w-full text-sm text-slate-500 sm:w-auto">レギュレーション:</span>
        <button type="button" class={chip} data-filter="regulation" data-value="" aria-pressed="true">すべて</button>
        {STANDARD_REGULATIONS.map((m) => <button type="button" class={chip} data-filter="regulation" data-value={m} aria-pressed="false">{m}</button>)}
        <span class="ml-1 inline-flex items-center gap-1 text-xs text-emerald-700"><span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>H・I・J はスタンダードで使用可能</span>
      </div>
    </div>

    <p class="mb-4 text-sm text-slate-500" aria-live="polite">
      <span id="card-count">{cards.length}</span>件のカードを表示中
    </p>

    <div id="card-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card, i) => <CardItem card={card} eager={i < 3} cheapest={cheapestIds.has(card.id)} />)}
    </div>

    <div id="card-empty" class="hidden rounded-2xl border border-dashed border-slate-300 py-16 text-center text-slate-500">
      <p class="font-medium">該当するカードが見つかりませんでした</p>
      <p class="mt-1 text-sm">キーワードやレアリティを変えてお試しください。</p>
    </div>

    <AffiliatePixels cards={cards} />

    <p class="mt-6 text-xs leading-relaxed text-slate-400">
      ※ 価格は各ショップの掲載情報をもとにした参考価格です。在庫状況や状態（美品・傷あり等）により実際の価格は変動します。購入・買取の前に必ず各ショップで最新情報をご確認ください。
    </p>
  </section>

  {posts.length > 0 && (
    <section aria-labelledby="columns" class="mt-16">
      <div class="mb-6 flex items-end justify-between">
        <h2 id="columns" class="text-xl font-bold text-slate-900">ポケカお役立ちコラム</h2>
        <a href="/blog/" class="text-sm text-blue-600 hover:underline">コラム一覧を見る →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="mt-8 text-center">
        <a href="/blog/" class="inline-block rounded-xl border border-blue-600 px-6 py-3 text-sm font-bold text-blue-600 transition hover:bg-blue-600 hover:text-white">コラム一覧をすべて見る</a>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const grid = document.getElementById('card-grid')!;
  const input = document.getElementById('card-search') as HTMLInputElement;
  const sortSelect = document.getElementById('card-sort') as HTMLSelectElement;
  const countEl = document.getElementById('card-count')!;
  const emptyEl = document.getElementById('card-empty')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter-chip')];
  const items = [...grid.querySelectorAll<HTMLElement>('.card-item')];

  // 全角/半角・大文字/小文字・ひらがな/カタカナの違いを吸収して検索
  const normalize = (s: string) =>
    s
      .normalize('NFKC')
      .toLowerCase()
      .replace(/[ぁ-ゖ]/g, (c) => String.fromCharCode(c.charCodeAt(0) + 0x60))
      .replace(/\s+/g, ' ')
      .trim();

  const index = new Map(items.map((el) => [el, normalize(el.dataset.search ?? '')]));
  // 絞り込み条件（レアリティ・レギュレーション・キーワードはすべて AND 条件）
  const filters: Record<string, string> = { rarity: '', regulation: '' };

  const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    new: (a, b) => Number(b.dataset.updated) - Number(a.dataset.updated),
    // 在庫なし（data-sale が空）は最後に並べる
    'sale-asc': (a, b) => (a.dataset.sale ? Number(a.dataset.sale) : Infinity) - (b.dataset.sale ? Number(b.dataset.sale) : Infinity),
    // 要査定（data-buyback が空）は最後に並べる
    'buyback-desc': (a, b) => (b.dataset.buyback ? Number(b.dataset.buyback) : -Infinity) - (a.dataset.buyback ? Number(a.dataset.buyback) : -Infinity),
  };

  function update() {
    const terms = normalize(input.value).split(' ').filter(Boolean);
    let visible = 0;
    for (const el of items) {
      const text = index.get(el)!;
      const show =
        (!filters.rarity || el.dataset.rarity === filters.rarity) &&
        (!filters.regulation || el.dataset.regulation === filters.regulation) &&
        terms.every((t) => text.includes(t));
      el.hidden = !show;
      if (show) visible++;
    }
    grid.append(...[...items].sort(sorters[sortSelect.value] ?? sorters.new));
    countEl.textContent = String(visible);
    emptyEl.classList.toggle('hidden', visible > 0);
  }

  input.addEventListener('input', update);
  sortSelect.addEventListener('change', update);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const group = chip.dataset.filter ?? '';
      filters[group] = chip.dataset.value ?? '';
      for (const c of chips) if (c.dataset.filter === group) c.setAttribute('aria-pressed', String(c === chip));
      update();
    });
  }
  // ブラウザの「戻る」で入力値が復元された場合にも反映
  update();
</script>
