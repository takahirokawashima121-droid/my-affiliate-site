---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardItem from '../components/CardItem.astro';
import AffiliatePixels from '../components/AffiliatePixels.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedDecks from '../components/FeaturedDecks.astro';
import { DECK_COLUMNS } from '../data/deck-columns';
import { TIER_LIST, TIER_SOURCES } from '../data/tier';
import { SITE, STANDARD_REGULATIONS } from '../consts';
import { getCards, getRarities, latestUpdate, formatDateTime, cardPath, cardLabel, cardModel, cheapestVariantIds, bestOffer, hasSaleStock } from '../utils/cards';
import { getPosts } from '../utils/posts';

const cards = await getCards();
const rarities = getRarities(cards);
const cheapestIds = cheapestVariantIds(cards); // 同名カードが複数あるときの最安版
const updated = latestUpdate(cards);
const posts = (await getPosts()).slice(0, 6);
// 環境Tier表への導線に出す Tier1・Tier2 のデッキ名
const tierPreview = TIER_LIST.tiers.slice(0, 2).map((t) => ({
  label: t.label,
  rank: t.rank,
  title: t.title,
  decks: t.decks.map((d) => ({ slug: d.slug, name: DECK_COLUMNS.find((c) => c.slug === d.slug)?.deckName ?? d.slug })),
}));

// 構造化データ：サイト情報 + 掲載カード一覧（商品と最安値）
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    description: SITE.description,
    url: Astro.site?.toString(),
    inLanguage: SITE.lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '現行スタンダード（H・I・J）デッキパーツ一覧',
    numberOfItems: cards.length,
    itemListElement: cards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: cardLabel(c),
        sku: cardModel(c),
        url: new URL(cardPath(c), Astro.site).toString(),
        brand: { '@type': 'Brand', name: 'ポケモンカードゲーム' },
        ...(c.data.imageUrl && { image: new URL(c.data.imageUrl, Astro.site).toString() }),
        // 2大モールの最安値。どちらも在庫なしのカードは価格情報（Offer）を出さない
        ...(bestOffer(c) && {
          offers: {
            '@type': 'Offer',
            price: bestOffer(c)!.price,
            priceCurrency: 'JPY',
            seller: { '@type': 'Organization', name: bestOffer(c)!.shop },
            url: bestOffer(c)!.url,
          },
        }),
      },
    })),
  },
];

const chip =
  'filter-chip rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-slate-300 bg-white text-slate-600 hover:border-blue-400 hover:text-blue-600 aria-pressed:border-amber-500 aria-pressed:bg-amber-500/90 aria-pressed:font-black aria-pressed:text-slate-950 aria-pressed:shadow-md aria-pressed:hover:border-amber-500 aria-pressed:hover:text-slate-950';
---

<BaseLayout jsonLd={jsonLd}>
  <!-- ヒーロー：現行スタンダード（H・I・J）で対戦するプレイヤー向けのデッキ研究＆パーツ調達ラボ -->
  <section class="bg-lab-panel lab-corners relative mb-8 overflow-hidden rounded-2xl border border-slate-300 px-5 pb-8 pt-10 text-slate-900 shadow-md sm:px-10 sm:pb-12 sm:pt-14">
    <!-- 白一色にならないよう、背後に薄いグラデーションの光彩を差し込む -->
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-amber-50/60 via-sky-50/40 to-transparent" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-emerald-100/40 blur-3xl" aria-hidden="true"></div>
    <div class="bg-hazard absolute inset-x-0 top-0 h-1.5" aria-hidden="true"></div>
    <p class="unit-label absolute right-5 top-4 sm:right-8" aria-hidden="true">SYSTEM SPEC // LAB-01</p>
    <!-- 装飾：研究所の歯車 -->
    <svg class="pointer-events-none absolute -right-10 -top-6 h-40 w-40 text-slate-300/60 sm:-right-4 sm:top-4 sm:h-64 sm:w-64" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" aria-hidden="true">
      <path d="M50 8v12M50 80v12M8 50h12M80 50h12M20.3 20.3l8.5 8.5M71.2 71.2l8.5 8.5M20.3 79.7l8.5-8.5M71.2 28.8l8.5-8.5" stroke-linecap="square" stroke-width="9"></path>
      <circle cx="50" cy="50" r="28"></circle>
      <circle cx="50" cy="50" r="11"></circle>
    </svg>
    <svg class="pointer-events-none absolute bottom-6 right-24 hidden h-20 w-20 text-amber-400/30 sm:block" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="6" aria-hidden="true">
      <path d="M50 10v14M50 76v14M10 50h14M76 50h14M21.7 21.7l9.9 9.9M68.4 68.4l9.9 9.9M21.7 78.3l9.9-9.9M68.4 31.6l9.9-9.9" stroke-linecap="square" stroke-width="10"></path>
      <circle cx="50" cy="50" r="24"></circle>
    </svg>

    <ul class="relative flex flex-wrap gap-2" aria-label="対象">
      <li class="nameplate border-red-200 bg-red-50 text-red-700">競技プレイヤー専用</li>
      <li class="nameplate border-emerald-200 bg-emerald-50 text-emerald-700">現行レギュレーション H・I・J 特化</li>
    </ul>
    <h1 class="relative mt-5 font-rounded text-[2rem] font-extrabold leading-tight tracking-tight sm:text-6xl">
      <!-- 看板：ファイアレッド → インダストリアルオレンジのグラデーション文字 -->
      <span class="whitespace-nowrap bg-gradient-to-r from-red-600 via-orange-500 to-amber-500 bg-clip-text pb-1 text-transparent">{SITE.title}</span>
      <span class="mt-2 block h-1 w-24 bg-hazard sm:w-32" aria-hidden="true"></span>
    </h1>
    <p class="relative mt-4 max-w-2xl text-base font-bold leading-relaxed text-slate-700 sm:text-xl">バトルに勝つためのデッキ研究＆パーツ調達サポートサイト</p>

    <!-- 当工房の特徴 -->
    <h2 class="unit-label relative mt-8">当工房の特徴 / FEATURES</h2>
    <ul class="relative mt-2 grid gap-3 md:grid-cols-3">
      {[
        // アイコン：レンチ（研究）・電球（ひらめき＝最安の発見）・シールド（スタン落ち防止）
        { no: '01', tone: 'border-t-amber-400 hover:border-amber-300 hover:bg-amber-50/50', iconTone: 'border-amber-200 bg-amber-100 text-amber-600', title: 'ジムバトル優勝レシピの分析', body: '勝率を高める60枚の採用理由と立ち回りを研究', icon: 'M14.7 6.3a4 4 0 0 0-5.4 5.1L3.5 17.2a1.8 1.8 0 0 0 2.5 2.5l5.8-5.8a4 4 0 0 0 5.1-5.4l-2.4 2.4-2.2-.4-.4-2.2 2.4-2.4Z' },
        { no: '02', tone: 'border-t-sky-400 hover:border-sky-300 hover:bg-sky-50/50', iconTone: 'border-sky-200 bg-sky-100 text-sky-600', title: '最安パーツ一括調達', body: '不足しているカードの最安値をショップ横断で即時チェック', icon: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1.1 2V16h5v-.2c.1-.8.5-1.5 1.1-2A6 6 0 0 0 12 3Z' },
        { no: '03', tone: 'border-t-emerald-400 hover:border-emerald-300 hover:bg-emerald-50/50', iconTone: 'border-emerald-200 bg-emerald-100 text-emerald-600', title: 'スタン落ち完全排除', body: 'H・I・J規格のみ掲載。使えないカードを買ってしまう事故を防止', icon: 'M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Zm-3.2 9 2.3 2.3 4.3-4.6' },
      ].map((f) => (
        <li class={`rounded-lg border border-t-4 border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md ${f.tone}`}>
          <span class="flex items-center justify-between">
            <span class={`grid h-11 w-11 place-items-center rounded-full border ${f.iconTone}`} aria-hidden="true">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={f.icon}></path></svg>
            </span>
            <span class="unit-label">SPEC-{f.no}</span>
          </span>
          <span class="mt-3 block text-sm font-black text-slate-900 sm:text-base">{f.title}</span>
          <span class="mt-1 block text-xs leading-relaxed text-slate-600 sm:text-sm">{f.body}</span>
        </li>
      ))}
    </ul>

    <p class="relative mt-6 rounded-r-md border-l-4 border-amber-500 bg-amber-50/70 py-2 pl-3 pr-2 text-xs leading-relaxed text-slate-700 sm:text-sm">
      ※当サイトは対戦プレイヤー専用のデッキ構築サポートサイトです。レアリティ相場・投資・PSA価値の追跡は一切行いません。実戦に必要な最安パーツを無駄なく揃えたいプレイヤーのために設計されています。
    </p>
    <p class="relative mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] text-slate-500">
      <span>PARTS: <span class="font-bold tabular-nums text-cyan-700">{cards.length}</span>種</span>
      <span>UPDATED: <span class="text-slate-700">{updated ? formatDateTime(updated) : '-'}</span></span>
    </p>
  </section>

  <!-- 環境Tier表への導線：戦況分析モニター（Tier1・Tier2 のデッキをチップで並べ、各デッキ解説へ直接飛べる） -->
  <section aria-labelledby="tier-monitor" class="bg-lab-panel lab-corners relative mb-8 overflow-hidden rounded-2xl border border-slate-300 p-4 pt-6 text-slate-900 shadow-md sm:p-6 sm:pt-7">
    <div class="bg-hazard absolute inset-x-0 top-0 h-1" aria-hidden="true"></div>
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-dashed border-slate-300 pb-3">
      <p class="flex items-center gap-2 font-mono text-[11px] font-bold tracking-widest text-cyan-700">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400/60 motion-reduce:animate-none"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan-500"></span>
        </span>
        TACTICAL BOARD / ENVIRONMENT MONITOR
      </p>
      <p class="unit-label">DATA UNIT · UPDATED {TIER_LIST.updated.replaceAll('-', '.')} ・ SRC ×{TIER_SOURCES.length}</p>
    </div>
    <h2 id="tier-monitor" class="mt-3 text-lg font-black sm:text-2xl"><span aria-hidden="true">📊</span> 最新環境Tier表（H・I・J）</h2>
    <p class="mt-1 text-xs text-slate-600 sm:text-sm">攻略サイト{TIER_SOURCES.length}社のTier評価と大会結果を突き合わせた、いま勝っているデッキの一覧です。デッキ名をタップするとレシピ解説へ。</p>

    <div class="mt-4 space-y-3">
      {tierPreview.map((t) => (
        <div class:list={['rounded-xl border p-3 sm:flex sm:items-start sm:gap-4 sm:p-4', t.rank === 1 ? 'border-2 border-amber-400 bg-amber-50/60 shadow-[inset_4px_0_0_var(--color-lamp)]' : 'border-slate-200 bg-white shadow-[inset_4px_0_0_var(--color-gauge)]']}>
          <div class="mb-2 flex shrink-0 items-center gap-2 sm:mb-0 sm:w-40 sm:flex-col sm:items-start sm:gap-1">
            <span class:list={['rounded-md px-2.5 py-1 font-mono text-sm font-black tracking-wider', t.rank === 1 ? 'bg-amber-500 text-white shadow-sm' : 'border border-cyan-300 bg-cyan-50 text-cyan-800']}>{t.label.toUpperCase()}</span>
            <span class:list={['text-xs font-bold', t.rank === 1 ? 'text-amber-700' : 'text-slate-700']}>{t.rank === 1 ? '環境トップ・勝率最上位' : t.title}</span>
            <span class="font-mono text-[10px] text-slate-500">{t.decks.length} DECKS</span>
          </div>
          <ul class="flex flex-1 flex-wrap gap-2">
            {t.decks.map((d) => (
              <li>
                <a
                  href={`/columns/${d.slug}/`}
                  class:list={[
                    'inline-flex min-h-[2.5rem] items-center gap-1.5 rounded-full border bg-white px-3.5 py-1.5 text-sm font-bold shadow-[0_1px_0_rgb(15_23_42/0.08),0_2px_4px_rgb(15_23_42/0.06)] transition hover:-translate-y-px hover:shadow-md active:translate-y-px',
                    t.rank === 1 ? 'border-amber-400 text-amber-800 hover:border-amber-500 hover:bg-amber-50' : 'border-slate-300 text-slate-800 hover:border-cyan-500 hover:text-cyan-800',
                  ]}
                >
                  {t.rank === 1 && <span aria-hidden="true">👑</span>}
                  {d.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <a href="/tier/" class="mt-4 flex items-center justify-center gap-2 rounded-lg border border-amber-400 px-4 py-3 text-sm font-black text-amber-700 transition hover:bg-amber-500 hover:text-white sm:text-base">
      Tier1〜3の全デッキ・評価の根拠を見る →
    </a>
  </section>

  <FeaturedDecks cards={cards} />

  <p class="mb-6 rounded-lg border border-slate-200 bg-white px-4 py-3 text-xs leading-relaxed text-slate-600 sm:text-sm" role="note">{SITE.priceNotice}</p>

  <!-- 検索・絞り込み・並び替え -->
  <section aria-labelledby="price-list">
    <h2 id="price-list" class="sr-only">デッキパーツ検索</h2>
    <div class="mb-6 space-y-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
      <div class="flex flex-col gap-3 sm:flex-row">
        <label class="relative flex-1">
          <span class="sr-only">カード名・型番・レアリティで検索</span>
          <svg class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path stroke-linecap="round" d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            id="card-search"
            type="search"
            placeholder="使いたいカード名を入力（例: なかよしポフィン、オーガポン）"
            autocomplete="off"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 py-3 pl-10 pr-3 text-base outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200"
          />
        </label>
        <label class="flex items-center gap-2 sm:w-56">
          <span class="shrink-0 text-sm text-slate-600">並び替え</span>
          <select
            id="card-sort"
            class="w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-base outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
          >
            <option value="new">新着順</option>
            <option value="sale-asc">販売が安い順</option>
            <option value="buyback-desc">買取が高い順</option>
          </select>
        </label>
      </div>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="レアリティで絞り込み">
        <span class="mr-1 w-full text-sm text-slate-600 sm:w-auto">レアリティ:</span>
        <button type="button" class={chip} data-filter="rarity" data-value="" aria-pressed="true">すべて</button>
        {rarities.map((r) => <button type="button" class={chip} data-filter="rarity" data-value={r} aria-pressed="false">{r === '-' ? '記号なし' : r}</button>)}
      </div>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="レギュレーションで絞り込み">
        <span class="mr-1 w-full text-sm text-slate-600 sm:w-auto">レギュレーション:</span>
        <button type="button" class={chip} data-filter="regulation" data-value="" aria-pressed="true">すべて</button>
        {STANDARD_REGULATIONS.map((m) => <button type="button" class={chip} data-filter="regulation" data-value={m} aria-pressed="false">{m}</button>)}
        <span class="ml-1 inline-flex items-center gap-1 text-xs text-emerald-600"><span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>H・I・J はスタンダードで使用可能</span>
      </div>
    </div>

    <p class="mb-4 text-sm text-slate-600" aria-live="polite">
      <span id="card-count">{cards.length}</span>件のカードを表示中
    </p>

    <div id="card-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card, i) => <CardItem card={card} eager={i < 3} cheapest={cheapestIds.has(card.id)} />)}
    </div>

    <div id="card-empty" class="hidden rounded-2xl border border-dashed border-slate-300 py-16 text-center text-slate-600">
      <p class="font-medium">該当するカードが見つかりませんでした</p>
      <p class="mt-1 text-sm">キーワードやレアリティを変えてお試しください。</p>
    </div>

    <AffiliatePixels cards={cards} shops={cards.some((c) => !hasSaleStock(c)) ? ['furuichi'] : []} />

    <p class="mt-6 text-xs leading-relaxed text-slate-600">
      ※ 価格は各ショップの掲載情報をもとにした参考価格です。在庫状況や状態（美品・傷あり等）により実際の価格は変動します。購入・買取の前に必ず各ショップで最新情報をご確認ください。
    </p>
  </section>

  {posts.length > 0 && (
    <section aria-labelledby="columns" class="mt-16">
      <div class="mb-6 flex items-end justify-between">
        <h2 id="columns" class="text-xl font-bold text-slate-900">デッキ研究コラム</h2>
        <a href="/blog/" class="text-sm text-blue-600 hover:underline">コラム一覧を見る →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="mt-8 text-center">
        <a href="/blog/" class="inline-block rounded-xl border border-blue-500 px-6 py-3 text-sm font-bold text-blue-600 transition hover:bg-blue-600 hover:text-slate-900">コラム一覧をすべて見る</a>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const grid = document.getElementById('card-grid')!;
  const input = document.getElementById('card-search') as HTMLInputElement;
  // ほかのページのボトムナビ「カード検索」（/#card-search）から来たときは検索欄を画面中央に出してフォーカス
  if (location.hash === '#card-search') {
    input.scrollIntoView({ block: 'center' });
    input.focus({ preventScroll: true });
  }
  const sortSelect = document.getElementById('card-sort') as HTMLSelectElement;
  const countEl = document.getElementById('card-count')!;
  const emptyEl = document.getElementById('card-empty')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter-chip')];
  const items = [...grid.querySelectorAll<HTMLElement>('.card-item')];

  // 全角/半角・大文字/小文字・ひらがな/カタカナの違いを吸収して検索
  const normalize = (s: string) =>
    s
      .normalize('NFKC')
      .toLowerCase()
      .replace(/[ぁ-ゖ]/g, (c) => String.fromCharCode(c.charCodeAt(0) + 0x60))
      .replace(/\s+/g, ' ')
      .trim();

  const index = new Map(items.map((el) => [el, normalize(el.dataset.search ?? '')]));
  // 絞り込み条件（レアリティ・レギュレーション・キーワードはすべて AND 条件）
  const filters: Record<string, string> = { rarity: '', regulation: '' };

  const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    new: (a, b) => Number(b.dataset.updated) - Number(a.dataset.updated),
    // 在庫なし（data-sale が空）は最後に並べる
    'sale-asc': (a, b) => (a.dataset.sale ? Number(a.dataset.sale) : Infinity) - (b.dataset.sale ? Number(b.dataset.sale) : Infinity),
    // 要査定（data-buyback が空）は最後に並べる
    'buyback-desc': (a, b) => (b.dataset.buyback ? Number(b.dataset.buyback) : -Infinity) - (a.dataset.buyback ? Number(a.dataset.buyback) : -Infinity),
  };

  function update() {
    const terms = normalize(input.value).split(' ').filter(Boolean);
    let visible = 0;
    for (const el of items) {
      const text = index.get(el)!;
      const show =
        (!filters.rarity || el.dataset.rarity === filters.rarity) &&
        (!filters.regulation || el.dataset.regulation === filters.regulation) &&
        terms.every((t) => text.includes(t));
      el.hidden = !show;
      if (show) visible++;
    }
    grid.append(...[...items].sort(sorters[sortSelect.value] ?? sorters.new));
    countEl.textContent = String(visible);
    emptyEl.classList.toggle('hidden', visible > 0);
  }

  input.addEventListener('input', update);
  sortSelect.addEventListener('change', update);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const group = chip.dataset.filter ?? '';
      filters[group] = chip.dataset.value ?? '';
      for (const c of chips) if (c.dataset.filter === group) c.setAttribute('aria-pressed', String(c === chip));
      update();
    });
  }
  // ブラウザの「戻る」で入力値が復元された場合にも反映
  update();
</script>
