---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getAllTags, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return getAllTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  posts: Post[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`「${tag}」の記事一覧`} description={`「${tag}」に関する記事の一覧です。`}>
  <Breadcrumbs items={[{ name: 'ホーム', href: '/' }, { name: 'タグ一覧', href: '/tags/' }, { name: `#${tag}`, href: Astro.url.pathname }]} />
  <h1 class="mb-8 text-2xl font-bold text-gray-900 sm:text-3xl">#{tag} の記事（{posts.length}件）</h1>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
